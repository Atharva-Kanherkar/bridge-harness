{
  "name": "bridge-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "sidecar/claude-agent"
  ],
  "scripts": {
    "dev": "vite",
    "dev:app": "sh scripts/dev-latest.sh",
    "docs": "bunx serve docs-site",
    "build": "tsc -b && vite build",
    "prepare:browser-host": "sh scripts/prepare-browser-host.sh release",
    "prepare:browser-host:dev": "sh scripts/prepare-browser-host.sh debug",
    "prepare:daemon": "sh scripts/prepare-daemon.sh release",
    "prepare:daemon:dev": "sh scripts/prepare-daemon.sh debug",
    "prepare:safari-extension": "sh scripts/prepare-safari-extension.sh",
    "check": "tsc -b --pretty false && cargo check --manifest-path src-tauri/Cargo.toml --workspace",
    "check:builtin-adapters": "sh scripts/check-builtin-adapters.sh",
    "smoke:builtin-adapters": "sh scripts/smoke-builtin-adapters.sh",
    "test": "npm test --prefix sidecar/claude-agent && vitest run && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/dm-sans": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.8.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
