{
  "name": "bridge-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "sidecar/claude-agent"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare:browser-host": "sh scripts/prepare-browser-host.sh release",
    "prepare:browser-host:dev": "sh scripts/prepare-browser-host.sh debug",
    "prepare:daemon": "sh scripts/prepare-daemon.sh release",
    "prepare:daemon:dev": "sh scripts/prepare-daemon.sh debug",
    "prepare:safari-extension": "sh scripts/prepare-safari-extension.sh",
    "check": "tsc -b --pretty false && cargo check --manifest-path src-tauri/Cargo.toml --workspace",
    "test": "npm test --prefix sidecar/claude-agent && vitest run && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@fontsource/dm-sans": "^5.2.8",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
