      ],
      "type": "object"
    },
    {
      "properties": {
        "item": {
          "$ref": "#/definitions/OutgoingMessage"
        },
        "kind": {
          "enum": [
            "sent"
          ],
          "type": "string"
        }
      },
      "required": [
        "item",
        "kind"
      ],
      "type": "object"
    },
    {
      "properties": {
        "item": {
          "$ref": "#/definitions/OutgoingMessage"
        },
        "kind": {
          "enum": [
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "item",
        "kind"
      ],
      "type": "object"
    }
  ],
  "title": "SendOutgoingResult"
}
