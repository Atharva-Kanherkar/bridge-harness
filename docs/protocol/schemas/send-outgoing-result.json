{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "OutgoingAttachment": {
      "description": "An image a draft carries: a local file, checked to be an image by its content when attached and again when read.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "mime": {
          "description": "`image/png`, `image/jpeg`, `image/gif` or `image/webp`.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "default": "",
          "description": "Hex SHA-256 of the bytes when attached. A read refuses a file whose digest moved, so the image cannot change outside the draft's revision.",
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "mime",
        "name",
        "path"
      ],
      "type": "object"
    },
    "OutgoingDestination": {
      "description": "Where a draft is addressed. Names are kept as the agent wrote them (`#dev`, `@nina`); they are resolved to ids before offering send approval.\n\n`rename_all` renames the variant tags only, so multi-word fields carry an explicit rename to stay camelCase on the wire.",
      "oneOf": [
        {
          "properties": {
            "channel": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "slackChannel"
              ],
              "type": "string"
            }
          },
          "required": [
            "channel",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "channel": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "slackThread"
              ],
              "type": "string"
            },
            "thread": {
              "type": "string"
            }
          },
          "required": [
            "channel",
            "kind",
            "thread"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "slackDm"
              ],
              "type": "string"
            },
            "user": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "user"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "githubComment"
              ],
              "type": "string"
            },
            "number": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "repo": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "number",
            "repo"
          ],
          "type": "object"
        },
        {
          "properties": {
            "commentId": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "kind": {
              "enum": [
                "githubReviewReply"
              ],
              "type": "string"
            },
            "number": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "repo": {
              "type": "string"
            }
          },
          "required": [
            "commentId",
            "kind",
            "number",
            "repo"
          ],
          "type": "object"
        },
        {
          "properties": {
            "format": {
              "$ref": "#/definitions/OutgoingFormat"
            },
            "kind": {
              "enum": [
                "clipboard"
              ],
              "type": "string"
            }
          },
          "required": [
            "format",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "OutgoingFormat": {
      "description": "How a destination takes text. `slackMarkdown` is standard Markdown that Slack's connector converts itself (tables, headings and fenced code included); `slack` is mrkdwn, for text pasted into Slack by hand.",
      "enum": [
        "slackMarkdown",
        "slack",
        "github",
        "plain"
      ],
      "type": "string"
    },
    "OutgoingLintFinding": {
      "description": "One style-rule finding. `fixed` means Bridge already changed the text; a fixable finding that is not fixed is what the card's Fix button applies.",
      "properties": {
        "fixable": {
          "type": "boolean"
        },
        "fixed": {
          "type": "boolean"
        },
        "line": {
          "description": "1-based line in the body, when the finding has one.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "rule": {
          "description": "`no_em_dash`, `no_ai_attribution`, `slack_table`, `slack_heading`, `max_lines`.",
          "type": "string"
        }
      },
      "required": [
        "fixable",
        "fixed",
        "message",
        "rule"
      ],
      "type": "object"
    },
    "OutgoingMessage": {
      "properties": {
        "attachments": {
          "default": [],
          "description": "Images to send with the text, in order.",
          "items": {
            "$ref": "#/definitions/OutgoingAttachment"
          },
          "type": "array"
        },
        "body": {
          "description": "The text as written, in Markdown.",
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "destination": {
          "$ref": "#/definitions/OutgoingDestination"
        },
        "format": {
          "$ref": "#/definitions/OutgoingFormat"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "description": "The chip text: `Slack · #dev · thread`, `GitHub · owner/repo#123`.",
          "type": "string"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "lint": {
          "items": {
            "$ref": "#/definitions/OutgoingLintFinding"
          },
          "type": "array"
        },
        "permalink": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why the person wants this message, in the agent's words.",
          "type": "string"
        },
        "remoteRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "rendered": {
          "description": "The body as the destination shows it.",
          "type": "string"
        },
        "revision": {
          "description": "Bumped on every text change; edits and copies name the revision they saw.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "sentAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": "string"
        },
        "sourceId": {
          "description": "The draft this one was copied from when its chat was forked. The fork's transcript still names the original id, so a card looks for either.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/OutgoingState"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "body",
        "createdAt",
        "destination",
        "format",
        "id",
        "label",
        "lint",
        "reason",
        "rendered",
        "revision",
        "sessionId",
        "state",
        "updatedAt"
      ],
      "type": "object"
    },
    "OutgoingState": {
      "description": "Where a draft is in its life. `copied` returns to `draft` on an edit.",
      "enum": [
        "draft",
        "copied",
        "discarded",
        "sending",
        "sent",
        "failed"
      ],
      "type": "string"
    }
  },
  "oneOf": [
    {
      "properties": {
        "approvalToken": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "item": {
          "$ref": "#/definitions/OutgoingMessage"
        },
        "kind": {
          "enum": [
            "approvalRequired"
          ],
          "type": "string"
        },
        "rendered": {
          "type": "string"
        }
      },
      "required": [
