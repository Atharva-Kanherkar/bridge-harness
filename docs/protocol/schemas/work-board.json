{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Effort": {
      "description": "A reasoning-effort level on the wire. Mirrors `bridge_core::delegation::Effort` variant for variant; a mirror test in bridge-core keeps the two from drifting.",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "type": "string"
    },
    "HarnessId": {
      "description": "Which agent runs a session, e.g. 'claude', 'codex', 'gemini'. Identifies the agent only — how Bridge runs it is not encoded here.",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "JsSafeU64": {
      "maximum": 9007199254740991.0,
      "minimum": 0.0,
      "type": "integer"
    },
    "WorkBriefLimits": {
      "additionalProperties": false,
      "description": "Hard bounds on a briefing run. Reaching one terminates the run; a preflight estimate over one refuses it.",
      "properties": {
        "costCeilingMicrousd": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "maxOutputTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "maxToolCalls": {
          "format": "int64",
          "type": "integer"
        },
        "maxTurns": {
          "format": "int64",
          "type": "integer"
        },
        "maxWallSeconds": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "maxToolCalls",
        "maxTurns",
        "maxWallSeconds"
      ],
      "type": "object"
    },
    "WorkBriefRun": {
      "description": "One briefing run's outcome.",
      "properties": {
        "completedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "failureCode": {
          "description": "A stable code, not a message: `schema_invalid`, `budget_exceeded`, `provider_unsupported`, …",
          "type": [
            "string",
            "null"
          ]
        },
        "failureDetail": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "outputDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileReference": {
          "description": "The briefing configuration this run used, for provenance.",
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "description": "The hidden briefing session, for **Inspect run**.",
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/WorkBriefRunStatus"
        },
        "trigger": {
          "$ref": "#/definitions/WorkBriefTrigger"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkRunUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "startedAt",
        "status",
        "trigger"
      ],
      "type": "object"
    },
    "WorkBriefRunStatus": {
      "description": "How a briefing run ended.",
      "oneOf": [
        {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "Refused before starting — over budget, no eligible provider, cooldown.",
          "enum": [
            "skipped"
          ],
          "type": "string"
        }
      ]
    },
    "WorkBriefTrigger": {
      "description": "What started a briefing run.",
      "enum": [
        "manual",
        "focus",
        "schedule"
      ],
      "type": "string"
    },
    "WorkBriefingProfile": {
      "additionalProperties": false,
      "description": "The briefing model, pinned explicitly. Not a `ProfilePurpose`: profile validation wants exactly one profile per purpose, and briefing permits no fallback at all.",
      "properties": {
        "effort": {
          "anyOf": [
            {
              "$ref": "#/definitions/Effort"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness": {
          "$ref": "#/definitions/HarnessId"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "harness",
        "model"
      ],
      "type": "object"
    },
    "WorkEvidenceTarget": {
      "description": "A Bridge-derived place a task's evidence can be opened. Never a model-authored URL: an external link exists here only after Bridge resolved it and matched it against its connector's host allowlist.",
      "oneOf": [
        {
          "description": "A validated HTTPS permalink, with the host Bridge matched it against.",
          "properties": {
            "host": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "externalLink"
              ],
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "host",
            "kind",
            "url"
          ],
          "type": "object"
        },
        {
          "description": "A local Bridge session.",
          "properties": {
            "kind": {
              "enum": [
                "session"
              ],
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sessionId"
          ],
          "type": "object"
        }
      ]
    },
    "WorkFact": {
      "description": "One deterministic thing that needs doing.",
      "properties": {
        "action": {
          "$ref": "#/definitions/WorkFactAction"
        },
        "actionableAt": {
          "description": "When this became actionable — the board's secondary sort key, oldest first.",
          "type": "string"
        },
        "dedupeKey": {
          "description": "Stable across reads for the same underlying condition, and the board's final tie-break so ordering never depends on SQLite row order.",
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "freshness": {
          "$ref": "#/definitions/WorkFactFreshness"
        },
        "kind": {
          "$ref": "#/definitions/WorkFactKind"
        },
        "observedAt": {
          "description": "When Bridge last saw the state behind it.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/WorkFactSeverity"
        },
        "target": {
          "$ref": "#/definitions/WorkFactTarget"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "actionableAt",
        "dedupeKey",
        "freshness",
        "kind",
        "observedAt",
        "severity",
        "target",
        "title"
      ],
      "type": "object"
    },
    "WorkFactAction": {
      "description": "The one thing a human can do about a fact, derived from the state the fact was projected from.\n\nThere is no `clear` variant on purpose. A fact stops existing when the state under it changes; offering to dismiss one would let the board disagree with the database.",
      "oneOf": [
        {
          "description": "Open the failed check on its attempt. Only a new run or an explicit waiver changes a verdict, so this reviews — it does not resolve.",
          "properties": {
            "attemptId": {
              "type": "string"
            },
            "checkId": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "reviewCompletionCheck"
              ],
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            }
          },
          "required": [
            "attemptId",
            "checkId",
            "kind",
            "sessionId"
          ],
          "type": "object"
        },
        {
          "description": "Answer the approval holding this work. `approval_sequence` is the `session_entries` sequence of the request when the fact is the approval itself, and `None` when the fact is downstream of one.",
          "properties": {
            "approvalSequence": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "answerApproval"
              ],
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sessionId"
          ],
          "type": "object"
        },
        {
          "description": "Fast-forward the workspace onto its base ref — `worktrees/refresh_workspace_base`. Offered only for a live observation.",
          "properties": {
            "kind": {
              "enum": [
                "refreshWorkspaceBase"
              ],
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sessionId",
            "workspaceId"
          ],
          "type": "object"
        },
        {
          "description": "Measure the workspace against its base again. A stale or failed observation is not something to act on; it is something to re-observe.",
          "properties": {
            "kind": {
              "enum": [
                "refreshBaseObservation"
              ],
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sessionId",
            "workspaceId"
          ],
          "type": "object"
        }
      ]
    },
    "WorkFactFreshness": {
      "description": "How current the observation behind a fact is.",
      "oneOf": [
        {
          "description": "Projected from live SQLite state, or from an observation inside the staleness window.",
          "enum": [
            "live"
          ],
          "type": "string"
        },
        {
          "description": "The observation is real but old. Its numbers describe the past.",
          "enum": [
            "stale"
          ],
          "type": "string"
        },
        {
          "description": "The last attempt to observe this failed. Nothing is known.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "WorkFactKind": {
      "description": "Which deterministic condition a fact describes.",
      "oneOf": [
        {
          "description": "A required or optional completion check reported `failed` on an attempt that has not been verified, waived, or superseded.",
          "enum": [
            "failed_completion_check"
          ],
          "type": "string"
        },
        {
          "description": "A queued worker is parked because an ancestor session is waiting on a human.",
          "enum": [
            "blocked_worker_queue_item"
          ],
          "type": "string"
        },
        {
          "description": "An approval request nobody has answered. Past the approval deadline it is expired; before it, it is merely waiting.",
          "enum": [
            "actionable_approval"
          ],
          "type": "string"
        },
        {
          "description": "A workspace has drifted far enough behind its base branch to matter.",
          "enum": [
            "workspace_behind_base"
          ],
          "type": "string"
        }
      ]
    },
    "WorkFactSeverity": {
      "description": "How loudly a fact asks for attention — the board's primary sort key.",
      "oneOf": [
        {
          "description": "Work is stopped until a human acts.",
          "enum": [
            "blocking"
          ],
          "type": "string"
        },
        {
          "description": "Work continues, but something is wrong.",
          "enum": [
            "attention"
          ],
          "type": "string"
        },
        {
          "description": "Worth knowing, not worth interrupting for.",
          "enum": [
            "info"
          ],
          "type": "string"
        }
      ]
    },
    "WorkFactTarget": {
      "description": "What a fact is about, as an identity inside Bridge. Facts never carry an external link.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "session"
              ],
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sessionId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "workspace"
              ],
              "type": "string"
            },
            "sessionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspaceId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "workspaceId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "attemptId": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "completionAttempt"
              ],
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            }
          },
          "required": [
            "attemptId",
            "kind",
            "sessionId"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "workerQueueItem"
              ],
              "type": "string"
            },
            "queueId": {
              "type": "string"
            },
            "workspaceId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "queueId",
            "workspaceId"
          ],
          "type": "object"
        }
      ]
    },
    "WorkRunUsage": {
      "description": "What a briefing run cost.",
      "properties": {
        "cachedInputTokens": {
          "$ref": "#/definitions/JsSafeU64"
        },
        "costMicrousd": {
          "description": "Only when the provider exposes usage Bridge can trust.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "inputTokens": {
          "$ref": "#/definitions/JsSafeU64"
        },
        "outputTokens": {
          "$ref": "#/definitions/JsSafeU64"
        },
        "toolCalls": {
          "format": "int64",
          "type": "integer"
        },
        "turns": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "toolCalls",
        "turns"
      ],
      "type": "object"
    },
    "WorkSettings": {
      "additionalProperties": false,
      "description": "Work's configuration.",
      "properties": {
        "briefing": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkBriefingProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` means Work is facts-only. There is no implicit model."
        },
        "cooldownMinutes": {
          "format": "int64",
          "type": "integer"
        },
        "enabledConnectorInstances": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limits": {
          "$ref": "#/definitions/WorkBriefLimits"
        },
        "refreshIntervalMinutes": {
          "description": "`None` disables cadence refresh; manual still works.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "refreshOnFocus": {
          "type": "boolean"
        }
      },
      "required": [
        "cooldownMinutes",
        "enabledConnectorInstances",
        "limits",
        "refreshOnFocus"
      ],
      "type": "object"
    },
    "WorkSourceCoverage": {
      "description": "One connector instance's coverage in a run.",
      "properties": {
        "connectorFamily": {
          "type": "string"
        },
        "connectorInstanceId": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/WorkSourceStatus"
        }
      },
      "required": [
        "connectorFamily",
        "connectorInstanceId",
        "status"
      ],
      "type": "object"
    },
    "WorkSourceStatus": {
      "description": "How far a connector instance got in a briefing run. These are distinct states on purpose: \"available\" is not \"was read\".",
      "oneOf": [
        {
          "enum": [
            "failed",
            "auth_required"
          ],
          "type": "string"
        },
        {
          "description": "Installed, but no reviewed evidence resolver — never offered to a model.",
          "enum": [
            "ineligible"
          ],
          "type": "string"
        },
        {
          "description": "Reviewed and offered to the model.",
          "enum": [
            "eligible"
          ],
          "type": "string"
        },
        {
          "description": "The model called it.",
          "enum": [
            "consulted"
          ],
          "type": "string"
        },
        {
          "description": "The call returned successfully and can back evidence.",
          "enum": [
            "succeeded"
          ],
          "type": "string"
        }
      ]
    },
    "WorkSuggestions": {
      "description": "The state of the suggested-work half, and a non-sensitive explanation.",
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/WorkSuggestionsState"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "WorkSuggestionsState": {
      "description": "Why suggested work looks the way it does.",
      "oneOf": [
        {
          "enum": [
            "running",
            "ready"
          ],
          "type": "string"
        },
        {
          "description": "No briefing profile. Facts are the whole board, which is a normal way to run Work — not an error.",
          "enum": [
            "not_configured"
          ],
          "type": "string"
        },
        {
          "description": "A profile exists, but its provider has not passed the briefing policy conformance suite. Judgments stay off for it; nothing falls back.",
          "enum": [
            "provider_unsupported"
          ],
          "type": "string"
        },
        {
          "description": "The last run failed or was refused; the previous board is preserved.",
          "enum": [
            "degraded"
          ],
          "type": "string"
        }
      ]
    },
    "WorkTask": {
      "description": "One model-suggested task, after Bridge validated its identity and evidence.",
      "properties": {
        "canonicalResourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidenceBps": {
          "format": "int64",
          "type": "integer"
        },
        "connectorInstanceId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "evidenceDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceObservedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceTarget": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkEvidenceTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "description": "A versioned SHA-256 over length-prefixed connector and resource identities.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Durable row id. Ephemeral tasks have no fingerprint, so actions use this id.",
          "type": "string"
        },
        "missCount": {
          "description": "Consecutive successful source-scoped misses. Two makes a task stale; a connector failure never increments it.",
          "format": "int64",
          "type": "integer"
        },
        "pinned": {
          "type": "boolean"
        },
        "rank": {
          "format": "int64",
          "type": "integer"
        },
        "snoozedUntil": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceKind": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/WorkTaskState"
        },
        "title": {
          "description": "Untrusted external text. Bounded, and never an instruction.",
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "workspaceId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "confidenceBps",
        "connectorInstanceId",
        "createdAt",
        "id",
        "missCount",
        "pinned",
        "rank",
        "sourceKind",
        "state",
        "title",
        "updatedAt",
        "why"
      ],
      "type": "object"
    },
    "WorkTaskState": {
      "description": "Where a suggested task stands locally. `pinned` is orthogonal and lives on [`WorkTask`].",
      "enum": [
        "active",
        "snoozed",
        "done",
        "dismissed",
        "stale"
      ],
      "type": "string"
    }
  },
  "description": "`work/get_work_board`'s result.",
  "properties": {
    "facts": {
      "items": {
        "$ref": "#/definitions/WorkFact"
      },
      "type": "array"
    },
    "generatedAt": {
      "type": "string"
    },
    "latestRun": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkBriefRun"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "$ref": "#/definitions/WorkSettings"
    },
    "sources": {
      "items": {
        "$ref": "#/definitions/WorkSourceCoverage"
      },
      "type": "array"
    },
    "suggestions": {
      "$ref": "#/definitions/WorkSuggestions"
    },
    "tasks": {
      "items": {
        "$ref": "#/definitions/WorkTask"
      },
      "type": "array"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkRunUsage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "facts",
    "generatedAt",
    "settings",
    "sources",
    "suggestions",
    "tasks"
  ],
  "title": "WorkBoard",
  "type": "object"
}
