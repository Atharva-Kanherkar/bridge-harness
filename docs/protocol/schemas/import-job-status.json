{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ImportJob": {
      "description": "A background import: how far it has got and what came over so far. Sent by `imports/import_status` and live as `imports/progress`.",
      "properties": {
        "alreadyInBridge": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "changed": {
          "description": "Chats imported before whose source has changed since; kept as they were.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "currentProject": {
          "description": "The folder of the chat being read now.",
          "type": [
            "string",
            "null"
          ]
        },
        "errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "failed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "imported": {
          "description": "Chats and setup items written to Bridge.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "jobId": {
          "type": "string"
        },
        "leftOut": {
          "description": "Background runs from the OS temp folder, not imported.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "notCarried": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ImportNotCarried"
          },
          "type": "array"
        },
        "processed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "startedAt": {
          "type": "string"
        },
        "status": {
          "description": "`running`, `done` or `failed`.",
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "total": {
          "description": "Files the job reads: transcripts and setup items.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "alreadyInBridge",
        "changed",
        "failed",
        "imported",
        "jobId",
        "leftOut",
        "processed",
        "startedAt",
        "status",
        "tool",
        "total",
        "updatedAt"
      ],
      "type": "object"
    },
    "ImportNotCarried": {
      "description": "Something that did not come over, with how many times.",
      "properties": {
        "count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "count",
        "text"
      ],
      "type": "object"
    }
  },
  "description": "`imports/import_status`: the latest import, running or finished.",
  "properties": {
    "job": {
      "anyOf": [
        {
          "$ref": "#/definitions/ImportJob"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "ImportJobStatus",
  "type": "object"
}
