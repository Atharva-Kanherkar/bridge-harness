{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "RiskTier": {
      "description": "A file's importance for review triage. Mirrors `bridge_core::completion::RiskTier`.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "WorkspaceChangeKind": {
      "enum": [
        "added",
        "modified",
        "deleted",
        "renamed",
        "mode_only"
      ],
      "type": "string"
    },
    "WorkspaceFileChange": {
      "description": "One file's working-tree diff against `HEAD`. Mirrors `bridge_core::git::WorkspaceFileChange`.",
      "properties": {
        "additions": {
          "format": "int64",
          "type": "integer"
        },
        "binary": {
          "type": "boolean"
        },
        "changeKind": {
          "$ref": "#/definitions/WorkspaceChangeKind"
        },
        "deletions": {
          "format": "int64",
          "type": "integer"
        },
        "importance": {
          "$ref": "#/definitions/RiskTier"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lowSignal": {
          "description": "Lockfiles, generated output, vendored trees: real changes, low review signal. A UI may collapse these by default, but never omit them.",
          "type": "boolean"
        },
        "patch": {
          "description": "Unified diff text; empty for files detected as binary.",
          "type": "string"
        },
        "patchTruncated": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "previousPath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "additions",
        "binary",
        "changeKind",
        "deletions",
        "importance",
        "labels",
        "lowSignal",
        "patch",
        "patchTruncated",
        "path"
      ],
      "type": "object"
    },
    "WorkspaceRepositoryState": {
      "enum": [
        "normal",
        "unborn",
        "not_git"
      ],
      "type": "string"
    }
  },
  "description": "`workspaces/workspace_changes`' result: every path that differs from `HEAD` in the workspace's working tree, tracked or not. Mirrors `bridge_core::git::WorkspaceChangeset`.",
  "properties": {
    "baseCommit": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "items": {
        "$ref": "#/definitions/WorkspaceFileChange"
      },
      "type": "array"
    },
    "filesTruncated": {
      "type": "boolean"
    },
    "repositoryState": {
      "$ref": "#/definitions/WorkspaceRepositoryState"
    },
    "totalFiles": {
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "files",
    "filesTruncated",
    "repositoryState"
  ],
  "title": "WorkspaceChangesResult",
  "type": "object"
}
