{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HarnessId": {
      "description": "Which agent runs a session, e.g. 'claude', 'codex', 'gemini'. Identifies the agent only — how Bridge runs it is not encoded here.",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "WorkflowFiles": {
      "description": "Which built-in file, shell and web tools a run gets.",
      "oneOf": [
        {
          "description": "None: built-in tool families are denied, as in a briefing run.",
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "description": "A fresh task worktree of the workflow's project, under the Isolated write mode. Needs a project.",
          "enum": [
            "worktree"
          ],
          "type": "string"
        }
      ]
    },
    "WorkflowRun": {
      "description": "One firing of a workflow.",
      "properties": {
        "costMicrousd": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "missedSlots": {
          "format": "int64",
          "type": "integer"
        },
        "quotaUnknown": {
          "description": "The provider reported no usage, so the quota reserve could not be checked.",
          "type": "boolean"
        },
        "revisionId": {
          "type": "string"
        },
        "scheduledFor": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/WorkflowRunStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "triggerKind": {
          "$ref": "#/definitions/WorkflowTriggerKind"
        },
        "unread": {
          "type": "boolean"
        },
        "workflowId": {
          "type": "string"
        }
      },
      "required": [
        "createdAt",
        "dryRun",
        "id",
        "missedSlots",
        "quotaUnknown",
        "revisionId",
        "status",
        "triggerKind",
        "unread",
        "workflowId"
      ],
      "type": "object"
    },
    "WorkflowRunStatus": {
      "description": "Where a run is. The first four are active: at most one per workflow.",
      "oneOf": [
        {
          "enum": [
            "queued",
            "waiting_quota",
            "running",
            "waiting_approval",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "The session ended without the result block the workflow asks for.",
          "enum": [
            "unverified"
          ],
          "type": "string"
        },
        {
          "description": "Recorded, never run: another run of this workflow was active.",
          "enum": [
            "skipped"
          ],
          "type": "string"
        }
      ]
    },
    "WorkflowSummary": {
      "description": "One row of the workflow list.",
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "disabledReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "files": {
          "$ref": "#/definitions/WorkflowFiles"
        },
        "harness": {
          "$ref": "#/definitions/HarnessId"
        },
        "id": {
          "type": "string"
        },
        "lastRun": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkflowRun"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nextRunAt": {
          "description": "The next scheduled fire time, when the workflow could run on one.",
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "trigger": {
          "$ref": "#/definitions/WorkflowTrigger"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "approved",
        "enabled",
        "files",
        "harness",
        "id",
        "model",
        "name",
        "trigger",
        "updatedAt"
      ],
      "type": "object"
    },
    "WorkflowTrigger": {
      "description": "What starts a workflow.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Only Run now.",
          "properties": {
            "kind": {
              "enum": [
                "manual"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A 5-field cron expression read in an IANA timezone.",
          "properties": {
            "cron": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "schedule"
              ],
              "type": "string"
            },
            "timezone": {
              "type": "string"
            }
          },
          "required": [
            "cron",
            "kind",
            "timezone"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowTriggerKind": {
      "description": "Why a run started.",
      "oneOf": [
        {
          "enum": [
            "manual",
            "schedule"
          ],
          "type": "string"
        },
        {
          "description": "The latest of one or more slots missed while Bridge was not running.",
          "enum": [
            "catch_up"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "workflows": {
      "items": {
        "$ref": "#/definitions/WorkflowSummary"
      },
      "type": "array"
    }
  },
  "required": [
    "workflows"
  ],
  "title": "WorkflowList",
  "type": "object"
}
