{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Effort": {
      "description": "A reasoning-effort level on the wire. Mirrors `bridge_core::delegation::Effort` variant for variant; a mirror test in bridge-core keeps the two from drifting.",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "type": "string"
    },
    "LimitRecoveryMode": {
      "description": "The user's choice for a chat stopped by a usage limit.",
      "oneOf": [
        {
          "description": "Today's behavior: the chat stops and waits for the person.",
          "enum": [
            "off"
          ],
          "type": "string"
        },
        {
          "description": "Wait for the provider's stated reset, then continue on the same harness, model and effort.",
          "enum": [
            "resume"
          ],
          "type": "string"
        },
        {
          "description": "Switch to the backup model now and continue. A backup that also runs out waits for its own reset.",
          "enum": [
            "backup"
          ],
          "type": "string"
        }
      ]
    },
    "LimitRecoveryState": {
      "description": "Where one chat's recovery stands.",
      "oneOf": [
        {
          "description": "Waiting for `dueAt`.",
          "enum": [
            "pending"
          ],
          "type": "string"
        },
        {
          "description": "Bridge is switching or sending the continue turn right now.",
          "enum": [
            "acting"
          ],
          "type": "string"
        },
        {
          "description": "The continue turn was sent.",
          "enum": [
            "done"
          ],
          "type": "string"
        },
        {
          "description": "The person cancelled it, sent a message themselves, or changed the chat's model.",
          "enum": [
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "The limit kept coming back and Bridge stopped trying.",
          "enum": [
            "gave_up"
          ],
          "type": "string"
        },
        {
          "description": "Bridge was closed past the due time by more than the catch-up window.",
          "enum": [
            "expired"
          ],
          "type": "string"
        },
        {
          "description": "The switch or the send failed; `outcome` says why.",
          "enum": [
            "failed"
          ],
          "type": "string"
        }
      ]
    },
    "LimitRecoveryTarget": {
      "additionalProperties": false,
      "description": "The model a chat switches to under [`LimitRecoveryMode::Backup`].",
      "properties": {
        "effort": {
          "anyOf": [
            {
              "$ref": "#/definitions/Effort"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`None` keeps the model's default effort."
        },
        "harness": {
          "default": "",
          "description": "Harness id (`claude` | `codex` | `opencode` | ...).",
          "type": "string"
        },
        "model": {
          "default": null,
          "description": "`None` is the harness default model.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "LimitRecoveryView": {
      "properties": {
        "attempts": {
          "description": "Limits in a row this chat hit while recovering.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "dueAt": {
          "description": "When Bridge will act, RFC 3339.",
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/LimitRecoveryMode"
        },
        "outcome": {
          "description": "Why it ended, for a finished row.",
          "type": [
            "string",
            "null"
          ]
        },
        "resetAt": {
          "description": "The reset the provider stated, RFC 3339, when it stated one.",
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": "string"
        },
        "signal": {
          "description": "The provider's phrase that started it (\"usage limit\").",
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/LimitRecoveryState"
        },
        "switchesModel": {
          "description": "Whether acting switches the chat's model first.",
          "type": "boolean"
        },
        "target": {
          "allOf": [
            {
              "$ref": "#/definitions/LimitRecoveryTarget"
            }
          ],
          "description": "What the chat continues on."
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "attempts",
        "dueAt",
        "mode",
        "sessionId",
        "signal",
        "state",
        "switchesModel",
        "target",
        "updatedAt"
      ],
      "type": "object"
    }
  },
  "description": "A chat's latest recovery row, or none.",
  "properties": {
    "recovery": {
      "anyOf": [
        {
          "$ref": "#/definitions/LimitRecoveryView"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "LimitRecoveryStatus",
  "type": "object"
}
