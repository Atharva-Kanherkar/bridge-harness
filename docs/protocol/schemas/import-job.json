{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ImportNotCarried": {
      "description": "Something that did not come over, with how many times.",
      "properties": {
        "count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "count",
        "text"
      ],
      "type": "object"
    }
  },
  "description": "A background import: how far it has got and what came over so far. Sent by `imports/import_status` and live as `imports/progress`.",
  "properties": {
    "alreadyInBridge": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "changed": {
      "description": "Chats imported before whose source has changed since; kept as they were.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "currentProject": {
      "description": "The folder of the chat being read now.",
      "type": [
        "string",
        "null"
      ]
    },
    "errors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "failed": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "imported": {
      "description": "Chats, memories and setup items written to Bridge.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "jobId": {
      "type": "string"
    },
    "leftOut": {
      "description": "Background runs from the OS temp folder, not imported.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "memories": {
      "description": "Memories among `imported`.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "notCarried": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ImportNotCarried"
      },
      "type": "array"
    },
    "processed": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "startedAt": {
      "type": "string"
    },
    "status": {
      "description": "`running`, `done` or `failed`.",
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "total": {
      "description": "Files the job reads: transcripts, memories and setup items.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "alreadyInBridge",
    "changed",
    "failed",
    "imported",
    "jobId",
    "leftOut",
    "memories",
    "processed",
    "startedAt",
    "status",
    "tool",
    "total",
    "updatedAt"
  ],
  "title": "ImportJob",
  "type": "object"
}
