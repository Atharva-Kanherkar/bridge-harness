{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "MemoryExclusionCount": {
      "description": "How many packets left a record out for one reason, as the audit coded it.",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "count"
      ],
      "type": "object"
    },
    "MemoryInsightsReport": {
      "description": "The Memory Insights report. `stats` and `kinds` are Bridge's own figures; the prose is the model's.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "highlights": {
          "items": {
            "$ref": "#/definitions/UsageInsightHighlight"
          },
          "type": "array"
        },
        "memoriesAnalysed": {
          "format": "int64",
          "type": "integer"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stats": {
          "$ref": "#/definitions/MemoryRecallStats"
        },
        "summary": {
          "type": "string"
        },
        "themes": {
          "items": {
            "$ref": "#/definitions/UsageInsightTheme"
          },
          "type": "array"
        }
      },
      "required": [
        "headline",
        "highlights",
        "memoriesAnalysed",
        "recommendations",
        "stats",
        "summary",
        "themes"
      ],
      "type": "object"
    },
    "MemoryKindUse": {
      "description": "Active records of one kind and how many of them reached a packet.",
      "properties": {
        "active": {
          "format": "int64",
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "recalled": {
          "description": "Active records of this kind recalled at least once in the window.",
          "format": "int64",
          "type": "integer"
        },
        "recalls": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "active",
        "kind",
        "recalled",
        "recalls"
      ],
      "type": "object"
    },
    "MemoryRecallStat": {
      "description": "One record's recall history over the last 14 days of packet audits.",
      "properties": {
        "daily": {
          "description": "14-day recall series, oldest first.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "inPacketRatio": {
          "description": "recalls / packets built in the window.",
          "format": "double",
          "type": "number"
        },
        "lastRecalledDay": {
          "description": "Day bucket of the last recall (0 = 13 days ago, 13 = today); -1 if none.",
          "format": "int64",
          "type": "integer"
        },
        "recalls": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "daily",
        "id",
        "inPacketRatio",
        "lastRecalledDay",
        "recalls"
      ],
      "type": "object"
    },
    "MemoryRecallStats": {
      "description": "Recall analytics for the account scope, folded from the retrieval audits. It measures delivery (what reached a prompt), not whether the model used it.",
      "properties": {
        "activeRecords": {
          "format": "int64",
          "type": "integer"
        },
        "budgetCharsMax": {
          "format": "int64",
          "type": "integer"
        },
        "budgetCharsUsed": {
          "format": "int64",
          "type": "integer"
        },
        "byKind": {
          "items": {
            "$ref": "#/definitions/MemoryKindUse"
          },
          "type": "array"
        },
        "exclusions": {
          "items": {
            "$ref": "#/definitions/MemoryExclusionCount"
          },
          "type": "array"
        },
        "injectionsPerDay": {
          "description": "Packets built per day bucket, oldest first, 14 entries.",
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "packets": {
          "description": "Packets built in the window, and how many carried at least one memory.",
          "format": "int64",
          "type": "integer"
        },
        "packetsWithMemories": {
          "format": "int64",
          "type": "integer"
        },
        "perRecord": {
          "items": {
            "$ref": "#/definitions/MemoryRecallStat"
          },
          "type": "array"
        },
        "recalledRecords": {
          "description": "Active records recalled at least once in the window.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "activeRecords",
        "budgetCharsMax",
        "budgetCharsUsed",
        "byKind",
        "exclusions",
        "injectionsPerDay",
        "packets",
        "packetsWithMemories",
        "perRecord",
        "recalledRecords"
      ],
      "type": "object"
    },
    "UsageInsightHighlight": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tone": {
          "$ref": "#/definitions/UsageInsightTone"
        }
      },
      "required": [
        "detail",
        "title",
        "tone"
      ],
      "type": "object"
    },
    "UsageInsightTheme": {
      "description": "One theme the model found across the prompts it was shown. `share` is the model's estimate of the fraction of prompts it covers, 0–1.",
      "properties": {
        "example": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "share": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "label",
        "share"
      ],
      "type": "object"
    },
    "UsageInsightTone": {
      "description": "Emphasis on a highlight card, chosen by the model from a closed set.",
      "enum": [
        "neutral",
        "good",
        "watch"
      ],
      "type": "string"
    },
    "UsageInsightsStatus": {
      "description": "How a run ended. `unavailable` means no harness could be asked (nothing installed, or the one configured cannot run headless); `failed` names why the run that started did not produce a report.",
      "oneOf": [
        {
          "enum": [
            "ready",
            "unavailable",
            "failed"
          ],
          "type": "string"
        },
        {
          "description": "No report has ever been generated; nothing was attempted.",
          "enum": [
            "empty"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "harness": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/definitions/MemoryInsightsReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/definitions/UsageInsightsStatus"
    }
  },
  "required": [
    "status"
  ],
  "title": "MemoryInsightsResult",
  "type": "object"
}
