{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "PromptLayerSource": {
      "description": "How a provider-owned layer's byte count was obtained. Closed vocabulary — mirrors `bridge_core::prompt_studio::PromptLayerSource`.",
      "oneOf": [
        {
          "description": "The provider reported the number itself.",
          "enum": [
            "reported"
          ],
          "type": "string"
        },
        {
          "description": "Bridge observed the exact bytes.",
          "enum": [
            "measured"
          ],
          "type": "string"
        },
        {
          "description": "A labelled approximation.",
          "enum": [
            "estimated"
          ],
          "type": "string"
        },
        {
          "description": "Nothing defensible exists.",
          "enum": [
            "unavailable"
          ],
          "type": "string"
        }
      ]
    },
    "PromptLintWarningView": {
      "description": "A required-vocabulary warning over a section's effective text.",
      "properties": {
        "marker": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "marker",
        "message"
      ],
      "type": "object"
    },
    "PromptProviderLayerStatus": {
      "description": "One provider-owned layer's honest standing inside a preview. Mirrors `bridge_core::prompt_studio::PromptProviderLayerStatus`.",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "bytes": {
          "description": "Exact byte size when actually readable; never invented.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "layer": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/PromptLayerSource"
        }
      },
      "required": [
        "adapter",
        "layer",
        "source"
      ],
      "type": "object"
    },
    "PromptRevisionOperation": {
      "description": "The closed mutation vocabulary of a revision. Mirrors `bridge_core::prompt_sections::PromptSectionOperation`.",
      "enum": [
        "override",
        "delete",
        "reset",
        "restore"
      ],
      "type": "string"
    },
    "PromptRevisionView": {
      "description": "One append-only revision of a prompt section.",
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "operation": {
          "$ref": "#/definitions/PromptRevisionOperation"
        },
        "restoredFromRevisionId": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/PromptSectionStatePayload"
        }
      },
      "required": [
        "createdAt",
        "id",
        "operation",
        "state"
      ],
      "type": "object"
    },
    "PromptSectionStatePayload": {
      "description": "Mirrors `bridge_core::prompt_sections::PromptSectionState` exactly.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "default"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "overridden"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "deleted"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "PromptSectionView": {
      "description": "One section of a resolved prompt stack. Mirrors `bridge_core::prompt_studio::PromptSectionView`.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "defaultText": {
          "description": "The built-in text this section falls back to when its state is default.",
          "type": "string"
        },
        "effectiveText": {
          "description": "The text the live compiler resolves to, or null when deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lintWarnings": {
          "items": {
            "$ref": "#/definitions/PromptLintWarningView"
          },
          "type": "array"
        },
        "revisions": {
          "description": "Append-only history, oldest first.",
          "items": {
            "$ref": "#/definitions/PromptRevisionView"
          },
          "type": "array"
        },
        "state": {
          "$ref": "#/definitions/PromptSectionStatePayload"
        },
        "tokenEstimate": {
          "description": "Byte-derived estimate (`ceil(bytes / 4)`), labelled as an estimate.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "bytes",
        "defaultText",
        "id",
        "lintWarnings",
        "revisions",
        "state",
        "tokenEstimate"
      ],
      "type": "object"
    },
    "PromptStackView": {
      "description": "The full studio view of one target's stack. Mirrors `bridge_core::prompt_studio::PromptStackView`.",
      "properties": {
        "depth": {
          "description": "Worker topology depth the stack was resolved at.",
          "format": "int64",
          "type": "integer"
        },
        "sections": {
          "items": {
            "$ref": "#/definitions/PromptSectionView"
          },
          "type": "array"
        },
        "target": {
          "description": "Storage key of the target (`orchestrator`, `worker:<role>`, `direct_session`) — same vocabulary the params enum accepts.",
          "type": "string"
        }
      },
      "required": [
        "depth",
        "sections",
        "target"
      ],
      "type": "object"
    }
  },
  "description": "The exact Bridge-authored envelopes for one target's resolved stack. Mirrors `bridge_core::prompt_studio::CompiledPromptPreview`.",
  "properties": {
    "depth": {
      "format": "int64",
      "type": "integer"
    },
    "prefixBytes": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "prefixHash": {
      "type": "string"
    },
    "prefixId": {
      "type": "string"
    },
    "prefixTokenEstimate": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "providerLayers": {
      "items": {
        "$ref": "#/definitions/PromptProviderLayerStatus"
      },
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "stablePrefix": {
      "description": "Exact `<bridge-stable-prompt …>` bytes compiled from the resolved sections alone — no project rules, tool schemas, or runtime variables.",
      "type": "string"
    },
    "stack": {
      "$ref": "#/definitions/PromptStackView"
    },
    "target": {
      "type": "string"
    },
    "variableSuffix": {
      "description": "Exact `<bridge-variable-context>` bytes with an empty sections list; runtime task/session/restoration content is never fabricated here.",
      "type": "string"
    }
  },
  "required": [
    "depth",
    "prefixBytes",
    "prefixHash",
    "prefixId",
    "prefixTokenEstimate",
    "providerLayers",
    "schemaVersion",
    "stablePrefix",
    "stack",
    "target",
    "variableSuffix"
  ],
  "title": "CompiledPromptPreviewResult",
  "type": "object"
}
