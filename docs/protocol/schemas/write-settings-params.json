{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Effort": {
      "description": "A reasoning-effort level on the wire. Mirrors `bridge_core::delegation::Effort` variant for variant; a mirror test in bridge-core keeps the two from drifting.",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "type": "string"
    },
    "HarnessId": {
      "description": "Which agent runs a session, e.g. 'claude', 'codex', 'gemini'. Identifies the agent only — how Bridge runs it is not encoded here.",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "WorkBriefLimits": {
      "additionalProperties": false,
      "description": "Hard bounds on a briefing run. Reaching one terminates the run; a preflight estimate over one refuses it.",
      "properties": {
        "costCeilingMicrousd": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "maxOutputTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "maxToolCalls": {
          "format": "int64",
          "type": "integer"
        },
        "maxTurns": {
          "format": "int64",
          "type": "integer"
        },
        "maxWallSeconds": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "maxToolCalls",
        "maxTurns",
        "maxWallSeconds"
      ],
      "type": "object"
    },
    "WorkBriefingProfile": {
      "additionalProperties": false,
      "description": "The briefing model, pinned explicitly. Not a `ProfilePurpose`: profile validation wants exactly one profile per purpose, and briefing permits no fallback at all.",
      "properties": {
        "effort": {
          "anyOf": [
            {
              "$ref": "#/definitions/Effort"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness": {
          "$ref": "#/definitions/HarnessId"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "harness",
        "model"
      ],
      "type": "object"
    },
    "WorkSettings": {
      "additionalProperties": false,
      "description": "Work's configuration.",
      "properties": {
        "briefing": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkBriefingProfile"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` means Work is facts-only. There is no implicit model."
        },
        "cooldownMinutes": {
          "format": "int64",
          "type": "integer"
        },
        "enabledConnectorInstances": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limits": {
          "$ref": "#/definitions/WorkBriefLimits"
        },
        "refreshIntervalMinutes": {
          "description": "`None` disables cadence refresh; manual still works.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "refreshOnFocus": {
          "type": "boolean"
        }
      },
      "required": [
        "cooldownMinutes",
        "enabledConnectorInstances",
        "limits",
        "refreshOnFocus"
      ],
      "type": "object"
    }
  },
  "properties": {
    "settings": {
      "$ref": "#/definitions/WorkSettings"
    }
  },
  "required": [
    "settings"
  ],
  "title": "WriteSettingsParams",
  "type": "object"
}
