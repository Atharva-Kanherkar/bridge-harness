        "trigger",
        "workspaceId"
      ],
      "type": "object"
    },
    "ReviewJobStatus": {
      "description": "Where a review job is. `posted`, `failed`, `cancelled` and `interrupted` are terminal. `drafted` waits for a person to triage and post.",
      "oneOf": [
        {
          "enum": [
            "queued",
            "preparing",
            "reviewing",
            "drafted",
            "posting",
            "posted",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "Bridge stopped while the job was in flight. Retry starts it again.",
          "enum": [
            "interrupted"
          ],
          "type": "string"
        }
      ]
    },
    "ReviewPass": {
      "description": "One harness's run over a job. A fallback is a new pass in the same slot.",
      "properties": {
        "attempt": {
          "description": "The claim of the job this pass ran under, from 1. A pass of an earlier attempt was abandoned when its runner lost the job.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "costMicrousd": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "deniedRequests": {
          "description": "Permission requests the hidden session denied.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "description": "Which requested reviewer this pass stands for (0, or 1 for a second opinion).",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/ReviewPassStatus"
        },
        "tokensIn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "tokensOut": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "attempt",
        "costMicrousd",
        "deniedRequests",
        "harness",
        "id",
        "jobId",
        "slot",
        "status",
        "tokensIn",
        "tokensOut"
      ],
      "type": "object"
    },
    "ReviewPassStatus": {
      "enum": [
        "running",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "ReviewPostMode": {
      "description": "Whether findings wait for triage or post as soon as they are drafted.",
      "oneOf": [
        {
          "description": "Findings land in the pane; nothing reaches GitHub until a person posts.",
          "enum": [
            "draft"
          ],
          "type": "string"
        },
        {
          "description": "Bridge posts the review as soon as it is drafted.",
          "enum": [
            "auto"
          ],
          "type": "string"
        }
      ]
    },
    "ReviewSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "nit"
      ],
      "type": "string"
    },
    "ReviewSide": {
      "enum": [
        "LEFT",
        "RIGHT"
      ],
      "type": "string"
    },
    "ReviewTrigger": {
      "description": "What started a review.",
      "oneOf": [
        {
          "enum": [
            "manual"
          ],
          "type": "string"
        },
        {
          "description": "A new head commit on a watched PR (opt-in auto-review).",
          "enum": [
            "push"
          ],
          "type": "string"
        }
      ]
