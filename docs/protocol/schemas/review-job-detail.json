          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "outsideDiff": {
          "description": "True when its line falls outside the diff: it goes in the summary rather than inline.",
          "type": "boolean"
        },
        "passId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "postedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/definitions/ReviewSeverity"
        },
        "side": {
