        },
        "startLine": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "agreedBy",
        "body",
        "confidence",
        "decision",
        "fingerprint",
        "id",
        "jobId",
        "line",
        "outsideDiff",
        "passId",
        "path",
        "severity",
        "side",
        "title"
      ],
      "type": "object"
    },
    "ReviewFindingCounts": {
      "description": "Findings on a job, by severity.",
      "properties": {
        "critical": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "major": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "minor": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "nit": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
