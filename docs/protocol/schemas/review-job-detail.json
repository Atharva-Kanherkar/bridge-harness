          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "critical",
        "major",
        "minor",
        "nit",
        "total"
      ],
      "type": "object"
    },
    "ReviewFindingDecision": {
      "description": "What a person decided about a finding. Every decision is kept.",
      "enum": [
        "pending",
        "kept",
        "dropped",
        "edited"
      ],
      "type": "string"
    },
    "ReviewJob": {
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "findingCounts": {
          "$ref": "#/definitions/ReviewFindingCounts"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "harnesses": {
          "description": "The harness of each pass: the one that actually ran when a fallback replaced the one asked for, else the one asked for. Two entries mean a second opinion.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "headSha": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "number": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "postMode": {
          "$ref": "#/definitions/ReviewPostMode"
        },
        "postedReviewUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryOf": {
          "description": "The job this one retried.",
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/ReviewJobStatus"
