{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "RiskTier": {
      "description": "A file's importance for review triage. Mirrors `bridge_core::completion::RiskTier`.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "SessionChangesUnavailable": {
      "description": "Why a chat has no scoped changes view. Mirrors `bridge_core::chat_changes::SessionChangesUnavailable`.",
      "enum": [
        "no_folder",
        "not_git",
        "no_turns",
        "snapshot_failed"
      ],
      "type": "string"
    },
    "WorkspaceChangeKind": {
      "enum": [
        "added",
        "modified",
        "deleted",
        "renamed",
        "mode_only"
      ],
      "type": "string"
    },
    "WorkspaceChangesResult": {
      "description": "`workspaces/workspace_changes`' result: every path that differs from `HEAD` in the workspace's working tree, tracked or not. Mirrors `bridge_core::git::WorkspaceChangeset`.",
      "properties": {
        "baseCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "items": {
            "$ref": "#/definitions/WorkspaceFileChange"
          },
          "type": "array"
        },
        "filesTruncated": {
          "type": "boolean"
        },
        "repositoryState": {
          "$ref": "#/definitions/WorkspaceRepositoryState"
        },
        "totalFiles": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "files",
        "filesTruncated",
        "repositoryState"
      ],
      "type": "object"
    },
    "WorkspaceFileChange": {
      "description": "One file's working-tree diff against `HEAD`. Mirrors `bridge_core::git::WorkspaceFileChange`.",
      "properties": {
        "additions": {
          "format": "int64",
          "type": "integer"
        },
        "binary": {
          "type": "boolean"
        },
        "changeKind": {
          "$ref": "#/definitions/WorkspaceChangeKind"
        },
        "deletions": {
          "format": "int64",
          "type": "integer"
        },
        "importance": {
          "$ref": "#/definitions/RiskTier"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lowSignal": {
          "description": "Lockfiles, generated output, vendored trees: real changes, low review signal. A UI may collapse these by default, but never omit them.",
          "type": "boolean"
        },
        "patch": {
          "description": "Unified diff text; empty for files detected as binary.",
          "type": "string"
        },
        "patchTruncated": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "previousPath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "additions",
        "binary",
        "changeKind",
        "deletions",
        "importance",
        "labels",
        "lowSignal",
        "patch",
        "patchTruncated",
        "path"
      ],
      "type": "object"
    },
    "WorkspaceRepositoryState": {
      "enum": [
        "normal",
        "unborn",
        "not_git"
      ],
      "type": "string"
    }
  },
  "description": "`workspaces/session_changes`' result: what one chat's own turns changed, measured from the snapshot taken before its first turn and kept to the paths its turns touched. Mirrors `bridge_core::chat_changes::SessionChanges`.",
  "properties": {
    "additions": {
      "description": "Line totals across every changed file, including any past the bounded `changes.files` window.",
      "format": "int64",
      "type": "integer"
    },
    "available": {
      "type": "boolean"
    },
    "changes": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkspaceChangesResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "deletions": {
      "format": "int64",
      "type": "integer"
    },
    "since": {
      "description": "When the chat's baseline was taken (RFC 3339).",
      "type": [
        "string",
        "null"
      ]
    },
    "turns": {
      "description": "Turns recorded for the chat.",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "unavailableReason": {
      "anyOf": [
        {
          "$ref": "#/definitions/SessionChangesUnavailable"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "additions",
    "available",
    "deletions",
    "turns"
  ],
  "title": "SessionChangesResult",
  "type": "object"
}
