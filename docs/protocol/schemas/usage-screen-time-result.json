{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ScreenTimeAgentHistory": {
      "description": "`counting` while entries written before Screen Time existed are still being read; agent figures grow until it reads `complete`.",
      "enum": [
        "complete",
        "counting"
      ],
      "type": "string"
    },
    "ScreenTimeDay": {
      "description": "One local day. Your time is minutes the window was focused and in use; agent time is minutes counted chats spent working, added across chats.",
      "properties": {
        "agentSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "day": {
          "type": "string"
        },
        "humanSeconds": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentSeconds",
        "day",
        "humanSeconds"
      ],
      "type": "object"
    },
    "ScreenTimeHarness": {
      "properties": {
        "agentSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "chats": {
          "format": "int64",
          "type": "integer"
        },
        "harness": {
          "type": "string"
        }
      },
      "required": [
        "agentSeconds",
        "chats",
        "harness"
      ],
      "type": "object"
    },
    "ScreenTimeHour": {
      "properties": {
        "agentSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "hour": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "humanSeconds": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentSeconds",
        "hour",
        "humanSeconds"
      ],
      "type": "object"
    },
    "ScreenTimeProject": {
      "description": "One project's share of the range. Your time counts only minutes recorded with a chat of this project open; agent time follows the agent-time rules. `chats` is top-level chats that worked in the range.",
      "properties": {
        "agentSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "chats": {
          "format": "int64",
          "type": "integer"
        },
        "humanSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "projectId": {
          "description": "Null for chats with no project.",
          "type": [
            "string",
            "null"
          ]
        },
        "pullRequests": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentSeconds",
        "chats",
        "humanSeconds",
        "name",
        "pullRequests"
      ],
      "type": "object"
    },
    "ScreenTimePullRequest": {
      "properties": {
        "number": {
          "format": "int64",
          "type": "integer"
        },
        "openedDay": {
          "description": "Local day it was opened.",
          "type": "string"
        },
        "repo": {
          "description": "`owner/name`.",
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/ScreenTimePullRequestState"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "openedDay",
        "repo",
        "state",
        "title",
        "url"
      ],
      "type": "object"
    },
    "ScreenTimePullRequestState": {
      "description": "The last state Bridge read for the pull request.",
      "enum": [
        "open",
        "merged",
        "closed",
        "unknown"
      ],
      "type": "string"
    },
    "ScreenTimePullRequests": {
      "properties": {
        "closed": {
          "format": "int64",
          "type": "integer"
        },
        "merged": {
          "format": "int64",
          "type": "integer"
        },
        "open": {
          "format": "int64",
          "type": "integer"
        },
        "opened": {
          "format": "int64",
          "type": "integer"
        },
        "recent": {
          "description": "The newest pull requests opened in the range, at most 6.",
          "items": {
            "$ref": "#/definitions/ScreenTimePullRequest"
          },
          "type": "array"
        },
        "repos": {
          "description": "One entry per repository, most opened first.",
          "items": {
            "$ref": "#/definitions/ScreenTimeRepo"
          },
          "type": "array"
        }
      },
      "required": [
        "closed",
        "merged",
        "open",
        "opened",
        "recent",
        "repos"
      ],
      "type": "object"
    },
    "ScreenTimeRepo": {
      "properties": {
        "merged": {
          "format": "int64",
          "type": "integer"
        },
        "opened": {
          "format": "int64",
          "type": "integer"
        },
        "repo": {
          "description": "`owner/name`.",
          "type": "string"
        }
      },
      "required": [
        "merged",
        "opened",
        "repo"
      ],
      "type": "object"
    },
    "ScreenTimeTotals": {
      "description": "Everything ever recorded, regardless of the range asked for.",
      "properties": {
        "agentSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "agentSinceDay": {
          "description": "Local day of the first recorded minute of agent time.",
          "type": [
            "string",
            "null"
          ]
        },
        "humanSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "humanSinceDay": {
          "description": "Local day of the first recorded minute of your time.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agentSeconds",
        "humanSeconds"
      ],
      "type": "object"
    }
  },
  "properties": {
    "agentHistory": {
      "$ref": "#/definitions/ScreenTimeAgentHistory"
    },
    "allTime": {
      "$ref": "#/definitions/ScreenTimeTotals"
    },
    "days": {
      "description": "One entry per day in the range, oldest first, zeros included.",
      "items": {
        "$ref": "#/definitions/ScreenTimeDay"
      },
      "type": "array"
    },
    "harnesses": {
      "description": "Agent time per harness in the range, largest first.",
      "items": {
        "$ref": "#/definitions/ScreenTimeHarness"
      },
      "type": "array"
    },
    "hours": {
      "description": "Hours 0 to 23 in the range's zone, every hour present.",
      "items": {
        "$ref": "#/definitions/ScreenTimeHour"
      },
      "type": "array"
    },
    "projects": {
      "description": "Projects with any time or pull request in the range, busiest first.",
      "items": {
        "$ref": "#/definitions/ScreenTimeProject"
      },
      "type": "array"
    },
    "pullRequests": {
      "allOf": [
        {
          "$ref": "#/definitions/ScreenTimePullRequests"
        }
      ],
      "description": "Pull requests agents opened from Bridge chats in the range."
    },
    "sinceDay": {
      "type": "string"
    },
    "timeZone": {
      "type": "string"
    },
    "untilDay": {
      "type": "string"
    }
  },
  "required": [
    "agentHistory",
    "allTime",
    "days",
    "harnesses",
    "hours",
    "projects",
    "pullRequests",
    "sinceDay",
    "timeZone",
    "untilDay"
  ],
  "title": "UsageScreenTimeResult",
  "type": "object"
}
