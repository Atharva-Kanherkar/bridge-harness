    "SandboxMode": {
      "description": "Mirrors `bridge_core::model::SandboxMode`.",
      "enum": [
        "read_only",
        "workspace_write",
        "danger_full_access"
      ],
      "type": "string"
    }
  },
  "description": "`health/health`'s result. Mirrors `bridge_core::api::Health`.",
  "properties": {
    "adapters": {
      "items": {
        "$ref": "#/definitions/AdapterDescriptor"
      },
      "type": "array"
    },
    "database": {
      "type": "string"
    },
    "deployment": {
      "allOf": [
        {
          "$ref": "#/definitions/DeploymentInfo"
        }
      ],
      "default": {
        "credentialPolicy": "user-managed",
        "topology": "embedded"
      },
      "description": "The active execution topology and credential policy. Defaulted so a document from an older daemon still parses."
    },
    "harnesses": {
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Harness id → binary availability.",
      "type": "object"
    },
    "ok": {
      "type": "boolean"
    },
    "snapshot_count": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "snapshot_directory": {
      "type": "string"
    },
    "snapshot_total_bytes": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "telemetry_database": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "warnings": {
      "default": [],
      "description": "Actionable environment warnings (today: macOS TCC-protected project paths and ad-hoc code signing). Defaulted so a document from an older daemon still parses.",
      "items": {
        "$ref": "#/definitions/HealthWarning"
      },
      "type": "array"
    }
  },
  "required": [
    "adapters",
    "database",
    "harnesses",
    "ok",
    "snapshot_count",
    "snapshot_directory",
