        },
        "defaultModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "modelCatalog": {
          "allOf": [
            {
              "$ref": "#/definitions/ModelCatalogDiagnostics"
            }
          ],
          "default": {
            "expiresAt": null,
            "fetchedAt": null,
            "lastError": null,
            "source": "curated_fallback",
            "stale": false
          }
        },
        "models": {
          "items": {
            "$ref": "#/definitions/ModelOption"
          },
          "type": "array"
        },
        "sandboxModes": {
          "default": [],
          "items": {
            "$ref": "#/definitions/SandboxMode"
          },
          "type": "array"
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "authState",
        "available",
        "capabilities",
        "id",
        "label",
        "models"
      ],
      "type": "object"
    },
    "AuthState": {
      "description": "Mirrors `bridge_core::model::AuthState`.",
      "enum": [
        "signed_in",
        "signed_out",
        "unknown"
      ],
      "type": "string"
    },
    "CapabilityTier": {
      "description": "Mirrors `bridge_core::model::CapabilityTier`.",
      "enum": [
        "fast",
        "standard",
        "strong"
      ],
      "type": "string"
    },
    "CredentialPolicy": {
      "description": "Which credentials a deployment lets harnesses run on. Independent of [`ExecutionTopology`]: any topology can carry any policy.",
      "oneOf": [
        {
          "description": "Whatever the user signed the harness in with, subscription included.",
          "enum": [
            "user-managed"
          ],
          "type": "string"
        },
        {
          "description": "Metered credentials only: an API key or a cloud-provider account. A consumer-subscription login is refused before the session starts.",
          "enum": [
            "api-key-only"
          ],
          "type": "string"
        },
        {
          "description": "Only credentials the deployment's operator provisions through a cloud provider account. Gateway-issued credentials are not yet recognised.",
          "enum": [
            "enterprise-managed"
          ],
          "type": "string"
        }
      ]
    },
    "DeploymentInfo": {
      "description": "The deployment a daemon is running as, reported on `health/health`.",
      "properties": {
        "credentialPolicy": {
          "$ref": "#/definitions/CredentialPolicy"
        },
        "topology": {
          "$ref": "#/definitions/ExecutionTopology"
        }
      },
      "required": [
        "credentialPolicy",
        "topology"
      ],
      "type": "object"
    },
    "ExecutionTopology": {
      "description": "Where the runtime that owns a data directory runs. Informational: it says nothing about billing, which is [`CredentialPolicy`]'s job — location must not decide who pays.",
      "oneOf": [
        {
          "description": "Inside the desktop app's own process.",
          "enum": [
            "embedded"
          ],
          "type": "string"
        },
        {
          "description": "The `bridged` daemon on the user's machine.",
          "enum": [
            "local-daemon"
          ],
          "type": "string"
        },
        {
          "description": "A runner executing on someone else's machine or a sandbox.",
          "enum": [
            "remote-runner"
          ],
          "type": "string"
        }
      ]
    },
    "HealthWarning": {
      "description": "One actionable environment warning on the health response. Mirrors `bridge_core::health::HealthWarning`.",
      "properties": {
        "detail": {
          "description": "Actionable guidance: the symptom, the cause, and where the fix is.",
          "type": "string"
        },
        "id": {
          "description": "Stable kebab-case id, e.g. `macos-tcc-protected-path`.",
          "type": "string"
        },
        "paths": {
          "description": "The offending registered paths; empty when the warning is not about paths.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "detail",
        "id",
        "paths",
        "title"
      ],
      "type": "object"
    },
    "ModelCatalogDiagnostics": {
      "properties": {
        "expiresAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "fetchedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/definitions/ModelCatalogSource"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "stale"
      ],
      "type": "object"
    },
    "ModelCatalogSource": {
      "enum": [
        "runtime_api",
        "last_known_good",
        "curated_fallback"
      ],
      "type": "string"
    },
    "ModelLifecycle": {
      "enum": [
        "stable",
        "preview",
        "deprecated",
        "unknown"
      ],
      "type": "string"
    },
    "ModelOption": {
      "description": "Mirrors `bridge_core::model::ModelOption`.",
      "properties": {
        "available": {
          "default": true,
          "type": "boolean"
        },
        "compatible": {
          "default": true,
          "type": "boolean"
        },
        "defaultForTier": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "lifecycle": {
          "allOf": [
            {
              "$ref": "#/definitions/ModelLifecycle"
            }
          ],
          "default": "unknown"
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/definitions/ModelCatalogSource"
            }
          ],
          "default": "curated_fallback"
        },
        "supportedEffortLevels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/definitions/CapabilityTier"
        }
      },
      "required": [
        "defaultForTier",
        "id",
        "label",
        "tier"
      ],
      "type": "object"
