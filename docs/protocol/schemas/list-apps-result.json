{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppBadge": {
      "description": "Something waiting on the person in an app.",
      "properties": {
        "count": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "count"
      ],
      "type": "object"
    },
    "AppManifest": {
      "properties": {
        "description": {
          "type": "string"
        },
        "events": {
          "description": "Event types the app records, each prefixed with its namespace.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "Kebab-case, at most 40 characters, unique among apps.",
          "type": "string"
        },
        "memory": {
          "description": "Plain-language lines that limit what memory may keep from the app's events. Empty means memory never reads them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/AppSource"
        },
        "tools": {
          "items": {
            "$ref": "#/definitions/AppTool"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        },
        "views": {
          "items": {
            "$ref": "#/definitions/AppView"
          },
          "type": "array"
        }
      },
      "required": [
        "description",
        "events",
        "id",
        "memory",
        "name",
        "source",
        "tools",
        "version",
        "views"
      ],
      "type": "object"
    },
    "AppSlot": {
      "description": "A place in Bridge an app can show up besides the launcher.",
      "oneOf": [
        {
          "description": "A full screen of its own.",
          "enum": [
            "screen"
          ],
          "type": "string"
        },
        {
          "description": "A pane in a chat's dock.",
          "enum": [
            "dock"
          ],
          "type": "string"
        },
        {
          "description": "A card inside the conversation.",
          "enum": [
            "card"
          ],
          "type": "string"
        },
        {
          "description": "A command in the launcher.",
          "enum": [
            "launcher"
          ],
          "type": "string"
        },
        {
          "description": "A slot a newer daemon knows and this client does not. Core refuses it in a manifest.",
          "enum": [
            "other"
          ],
          "type": "string"
        }
      ]
    },
    "AppSource": {
      "description": "Where an app came from.",
      "oneOf": [
        {
          "description": "Ships with Bridge.",
          "enum": [
            "builtin"
          ],
          "type": "string"
        },
        {
          "description": "Installed by the person.",
          "enum": [
            "community"
          ],
          "type": "string"
        },
        {
          "description": "A source a newer daemon knows and this client does not.",
          "enum": [
            "other"
          ],
          "type": "string"
        }
      ]
    },
    "AppSummary": {
      "description": "An app as every client sees it: its manifest and its state on this Mac.",
      "properties": {
        "badge": {
          "anyOf": [
            {
              "$ref": "#/definitions/AppBadge"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the app has no badge, is off, or its count could not be read."
        },
        "canDisable": {
          "description": "False for the apps Bridge needs to manage the others (the Store).",
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "manifest": {
          "$ref": "#/definitions/AppManifest"
        },
        "pinned": {
          "description": "The sidebar position, from 0, or null when the app is not pinned.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "canDisable",
        "enabled",
        "manifest"
      ],
      "type": "object"
    },
    "AppTool": {
      "description": "One agent tool an app brings, as named on the `bridge` MCP server.",
      "properties": {
        "asksFirst": {
          "description": "The tool changes something outside the chat, so it runs only when the person allows it. A manifest can make a tool ask; it can never make a tool skip an approval that policy requires.",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "asksFirst",
        "name"
      ],
      "type": "object"
    },
    "AppView": {
      "properties": {
        "slot": {
          "$ref": "#/definitions/AppSlot"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "slot"
      ],
      "type": "object"
    },
    "PersonalAppEntry": {
      "description": "A locked personal app as the Store, the launcher and the sidebar see it.",
      "properties": {
        "app": {
          "$ref": "#/definitions/PersonalAppSummary"
        },
        "enabled": {
          "type": "boolean"
        },
        "pinned": {
          "description": "The sidebar position, from 0, or null when the app is not pinned.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "app",
        "enabled"
      ],
      "type": "object"
    },
    "PersonalAppSummary": {
      "description": "One locked version of a personal app, without its view.",
      "properties": {
        "contentHash": {
          "description": "`sha256:` over the app's canonical content.",
          "type": "string"
        },
        "harness": {
          "description": "The harness whose MCP connection the app uses.",
          "type": "string"
        },
        "id": {
          "description": "Kebab-case, at most 40 characters, never a built-in app's id.",
          "type": "string"
        },
        "intent": {
          "description": "What the app is for, in the person's words. Agents read it to decide when to open the app.",
          "type": "string"
        },
        "lockedAt": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reads": {
          "description": "Tools the view may call without asking. Each is a read by Bridge's read vocabulary.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "server": {
          "description": "The MCP server as that harness configures it (`claude.ai Slack`).",
          "type": "string"
        },
        "version": {
          "description": "1 for the first lock, one more for each lock that changed the content.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "viewBytes": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "writes": {
          "description": "Tools the view may call only after the person approves the exact call.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "contentHash",
        "harness",
        "id",
        "intent",
        "lockedAt",
        "name",
        "reads",
        "server",
        "version",
        "viewBytes",
        "writes"
      ],
      "type": "object"
    }
  },
  "properties": {
    "apps": {
      "items": {
        "$ref": "#/definitions/AppSummary"
      },
      "type": "array"
    },
    "personal": {
      "default": [],
      "description": "The person's locked personal apps (\"My apps\"), newest lock first.",
      "items": {
        "$ref": "#/definitions/PersonalAppEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "apps"
  ],
  "title": "ListAppsResult",
  "type": "object"
}
