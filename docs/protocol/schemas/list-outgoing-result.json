        },
        "rendered": {
          "description": "The body as the destination shows it.",
          "type": "string"
        },
        "revision": {
          "description": "Bumped on every text change; edits and copies name the revision they saw.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "sessionId": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/OutgoingState"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "body",
        "createdAt",
        "destination",
        "format",
        "id",
        "label",
        "lint",
        "reason",
        "rendered",
        "revision",
        "sessionId",
        "state",
        "updatedAt"
      ],
      "type": "object"
    },
    "OutgoingState": {
      "description": "Where a draft is in its life. `copied` returns to `draft` on an edit.",
      "enum": [
        "draft",
        "copied",
        "discarded"
      ],
      "type": "string"
    }
