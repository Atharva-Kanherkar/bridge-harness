        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "mime",
        "name",
        "path"
      ],
      "type": "object"
    },
    "OutgoingDestination": {
      "description": "Where a draft is addressed. Names are kept as the agent wrote them (`#dev`, `@nina`); resolving them to ids belongs to the slice that sends.\n\n`rename_all` renames the variant tags only, so multi-word fields carry an explicit rename to stay camelCase on the wire.",
      "oneOf": [
        {
          "properties": {
            "channel": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "slackChannel"
              ],
              "type": "string"
            }
          },
          "required": [
            "channel",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "channel": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "slackThread"
              ],
              "type": "string"
            },
            "thread": {
              "type": "string"
            }
          },
          "required": [
            "channel",
            "kind",
            "thread"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "slackDm"
              ],
              "type": "string"
            },
            "user": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "user"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "githubComment"
              ],
              "type": "string"
            },
            "number": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "repo": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "number",
            "repo"
          ],
          "type": "object"
        },
        {
          "properties": {
            "commentId": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "kind": {
              "enum": [
                "githubReviewReply"
              ],
              "type": "string"
            },
            "number": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "repo": {
              "type": "string"
            }
          },
          "required": [
            "commentId",
            "kind",
            "number",
            "repo"
          ],
          "type": "object"
