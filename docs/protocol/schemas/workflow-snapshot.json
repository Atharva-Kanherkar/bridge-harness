{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HarnessId": {
      "description": "Which agent runs a session, e.g. 'claude', 'codex', 'gemini'. Identifies the agent only — how Bridge runs it is not encoded here.",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "WorkBriefLimits": {
      "additionalProperties": false,
      "description": "Hard bounds on a briefing run. Reaching one terminates the run; a preflight estimate over one refuses it.",
      "properties": {
        "costCeilingMicrousd": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "maxOutputTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "maxToolCalls": {
          "format": "int64",
          "type": "integer"
        },
        "maxTurns": {
          "format": "int64",
          "type": "integer"
        },
        "maxWallSeconds": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "maxToolCalls",
        "maxTurns",
        "maxWallSeconds"
      ],
      "type": "object"
    },
    "Workflow": {
      "description": "A workflow at its current revision.",
      "properties": {
        "approved": {
          "description": "Whether the current revision is approved. Nothing runs unapproved.",
          "type": "boolean"
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "definition": {
          "$ref": "#/definitions/WorkflowDefinition"
        },
        "disabledReason": {
          "description": "Why Bridge turned it off, when it did (`project_removed`).",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "revisionId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "approved",
        "createdAt",
        "definition",
        "enabled",
        "id",
        "revision",
        "revisionId",
        "updatedAt"
      ],
      "type": "object"
    },
    "WorkflowDefinition": {
      "additionalProperties": false,
      "description": "Everything a person edits. Stored whole on every revision.",
      "properties": {
        "alwaysAllow": {
          "default": [],
          "description": "Exact `mcp__<server>__<tool>` identities that never ask.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "budget": {
          "$ref": "#/definitions/WorkBriefLimits"
        },
        "expectedResult": {
          "default": "",
          "type": "string"
        },
        "files": {
          "$ref": "#/definitions/WorkflowFiles"
        },
        "grants": {
          "default": [],
          "items": {
            "$ref": "#/definitions/WorkflowGrant"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "notify": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkflowNotify"
            }
          ],
          "default": {
            "onSuccess": false
          }
        },
        "projectId": {
          "default": null,
          "description": "`None` runs the workflow in a private folder Bridge manages.",
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "items": {
            "$ref": "#/definitions/WorkflowStep"
          },
          "type": "array"
        },
        "trigger": {
          "$ref": "#/definitions/WorkflowTrigger"
        }
      },
      "required": [
        "budget",
        "files",
        "name",
        "steps",
        "trigger"
      ],
      "type": "object"
    },
    "WorkflowFiles": {
      "description": "Which built-in file, shell and web tools a run gets.",
      "oneOf": [
        {
          "description": "None: built-in tool families are denied, as in a briefing run.",
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "description": "A fresh task worktree of the workflow's project, under the Isolated write mode. Needs a project.",
          "enum": [
            "worktree"
          ],
          "type": "string"
        }
      ]
    },
    "WorkflowGrant": {
      "additionalProperties": false,
      "description": "One connector server a workflow may use.",
      "properties": {
        "read": {
          "description": "Read-verb tools on this server run without asking.",
          "type": "boolean"
        },
        "server": {
          "description": "The server's id in the harness's own configuration.",
          "type": "string"
        },
        "write": {
          "$ref": "#/definitions/WorkflowWriteAccess"
        }
      },
      "required": [
        "read",
        "server",
        "write"
      ],
      "type": "object"
    },
    "WorkflowNotify": {
      "additionalProperties": false,
      "properties": {
        "onSuccess": {
          "default": false,
          "description": "Failures and approval requests always notify; successes only when set.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "WorkflowStep": {
      "additionalProperties": false,
      "description": "One step of a workflow. Phase 1 accepts exactly one.",
      "properties": {
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "$ref": "#/definitions/HarnessId"
        },
        "instructions": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "harness",
        "instructions",
        "model"
      ],
      "type": "object"
    },
    "WorkflowTrigger": {
      "description": "What starts a workflow.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Only Run now.",
          "properties": {
            "kind": {
              "enum": [
                "manual"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A 5-field cron expression read in an IANA timezone.",
          "properties": {
            "cron": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "schedule"
              ],
              "type": "string"
            },
            "timezone": {
              "type": "string"
            }
          },
          "required": [
            "cron",
            "kind",
            "timezone"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowWriteAccess": {
      "description": "Whether a granted server may be written to, and how.",
      "oneOf": [
        {
          "description": "No write tool on this server is reachable.",
          "enum": [
            "never"
          ],
          "type": "string"
        },
        {
          "description": "Every write asks a person first, unless its exact identity is in `alwaysAllow`.",
          "enum": [
            "ask"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "workflow": {
      "$ref": "#/definitions/Workflow"
    }
  },
  "required": [
    "workflow"
  ],
  "title": "WorkflowSnapshot",
  "type": "object"
}
