{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentDefinition": {
      "additionalProperties": false,
      "description": "A configured agent. Mirrors `bridge_core::agent_config::AgentDefinition`, including its refusal of unknown fields.",
      "properties": {
        "createdAt": {
          "default": "",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "effort": {
          "$ref": "#/definitions/Effort"
        },
        "enabled": {
          "type": "boolean"
        },
        "harness": {
          "type": "string"
        },
        "id": {
          "default": "",
          "description": "Empty when creating; the server assigns the id.",
          "type": "string"
        },
        "isBuiltIn": {
          "default": false,
          "type": "boolean"
        },
        "isDefault": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "systemPrompt": {
          "default": "",
          "type": "string"
        },
        "updatedAt": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "effort",
        "enabled",
        "harness",
        "name",
        "role"
      ],
      "type": "object"
    },
    "Effort": {
      "description": "A reasoning-effort level on the wire. Mirrors `bridge_core::delegation::Effort` variant for variant; a mirror test in bridge-core keeps the two from drifting.",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "type": "string"
    },
    "HarnessConfig": {
      "additionalProperties": false,
      "description": "Per-harness defaults. Mirrors `bridge_core::agent_config::HarnessConfig`, including its refusal of unknown fields.",
      "properties": {
        "advanced": {
          "default": {},
          "description": "Harness-specific settings passed through untouched."
        },
        "defaultModel": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/definitions/Effort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "isOverride": {
          "default": false,
          "description": "Set when this config overrides a built-in default.",
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "systemPrompt": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "id",
        "label"
      ],
      "type": "object"
    },
    "PermissionPolicy": {
      "description": "How much Bridge asks before an agent acts. Mirrors `bridge_core::agent_config::PermissionPolicy`.\n\n`default` on the container, not just the fields: a policy payload written by an older build must still read once slice 3 adds the graduated modes.",
      "properties": {
        "autoApproveProviderPermissions": {
          "default": false,
          "description": "Auto-accept every provider approval, for every agent. Worker write scope and browser outward effects are unaffected — those are authorization.",
          "type": "boolean"
        },
        "updatedAt": {
          "default": "",
          "type": "string"
        },
        "workerPromptProposalRoles": {
          "default": [],
          "description": "Allows these worker roles to propose guidance; each edit still requires a separate human approval of its exact text.",
          "items": {
            "$ref": "#/definitions/PromptProposalWorkerRole"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PromptProposalWorkerRole": {
      "enum": [
        "research",
        "implementation",
        "verification",
        "planning",
        "documentation"
      ],
      "type": "string"
    }
  },
  "description": "The configuration snapshot every config mutation returns. Mirrors `bridge_core::agent_config::ConfigState`.",
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/definitions/AgentDefinition"
      },
      "type": "array"
    },
    "defaultAgentId": {
      "type": "string"
    },
    "harnesses": {
      "items": {
        "$ref": "#/definitions/HarnessConfig"
      },
      "type": "array"
    },
    "permissionPolicy": {
      "$ref": "#/definitions/PermissionPolicy"
    }
  },
  "required": [
    "agents",
    "defaultAgentId",
    "harnesses",
    "permissionPolicy"
  ],
  "title": "ConfigState",
  "type": "object"
}
