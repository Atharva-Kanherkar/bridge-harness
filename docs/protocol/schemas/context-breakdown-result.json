        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "renderedEntryCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "restorationBoundaryEntryId": {
          "type": [
