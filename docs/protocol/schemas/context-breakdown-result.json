      "description": "Availability of one segment, mirroring the adapter inventory provenance vocabulary. `unavailable` segments carry a reason and contribute nothing to totals.",
      "enum": [
        "reported",
        "measured",
        "estimated",
        "unavailable"
      ],
      "type": "string"
    },
    "ContextBreakdownTotals": {
      "description": "Sums over available segments only. A unit is `None` when no available segment observed it — absence is preserved instead of zero-filling.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "itemCount": {
          "format": "uint64",
