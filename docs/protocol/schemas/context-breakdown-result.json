      "required": [
        "boundaryEntryId",
        "currentTokenEstimate",
        "firstRetainedEntryId",
        "growthTokens",
        "sourceAgent",
        "tokensBefore"
      ],
      "type": "object"
    },
    "ContextBreakdownOrigin": {
      "description": "Where a breakdown segment's numbers come from. Every segment names its source so clients never have to guess attribution.",
      "enum": [
        "conversation",
        "promptCompilation",
        "adapterInventory"
      ],
      "type": "string"
    },
    "ContextBreakdownSegment": {
      "description": "One bounded, source-labelled slice of a session's context.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "capped": {
          "description": "True when a value was clamped to the observation bounds upstream.",
          "type": "boolean"
        },
        "itemCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "method": {
          "description": "Estimation method when `state` is `estimated`.",
          "type": [
            "string",
            "null"
          ]
        },
        "names": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "origin": {
          "$ref": "#/definitions/ContextBreakdownOrigin"
        },
        "reason": {
          "description": "Why nothing could be observed when `state` is `unavailable`.",
          "type": [
            "string",
            "null"
          ]
        },
        "segmentClass": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/ContextBreakdownState"
