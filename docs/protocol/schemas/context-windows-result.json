{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContextBridgeContribution": {
      "description": "What Bridge itself put in the window: its compiled prompt sections.",
      "properties": {
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "stableTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "variableTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ContextCompactionOwner": {
      "description": "Who shrinks this window when it fills: the harness (Claude, Codex and OpenCode compact their own live context) or Bridge (agent-protocol harnesses with no compaction of their own).",
      "enum": [
        "harness",
        "bridge"
      ],
      "type": "string"
    },
    "ContextReadingState": {
      "description": "How a window reading's numbers were obtained.",
      "oneOf": [
        {
          "description": "The provider stated used and window tokens.",
          "enum": [
            "reported"
          ],
          "type": "string"
        },
        {
          "description": "The harness counted its own window.",
          "enum": [
            "measured"
          ],
          "type": "string"
        },
        {
          "description": "At least one figure is Bridge's own (a catalog window size).",
          "enum": [
            "estimated"
          ],
          "type": "string"
        }
      ]
    },
    "ContextSegmentKind": {
      "description": "The classification Claude Code gives each `/context` row: `used` content occupies the window, `free` is headroom, `buffer` is the compaction reserve, `deferred` tool schemas sit outside the window until loaded.",
      "enum": [
        "used",
        "free",
        "buffer",
        "deferred"
      ],
      "type": "string"
    },
    "ContextWindow": {
      "description": "One live window in the chat's agent tree.",
      "properties": {
        "current": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContextWindowReading"
            },
            {
              "type": "null"
            }
          ],
          "description": "The newest reading of the window as it is now; `null` when there is none, with `unavailableReason` saying why. Never a zero."
        },
        "depth": {
          "format": "int64",
          "type": "integer"
        },
        "harness": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/definitions/ContextWindowRole"
        },
        "sessionId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "depth",
        "harness",
        "kind",
        "label",
        "role",
        "sessionId",
        "status"
      ],
      "type": "object"
    },
    "ContextWindowConsumer": {
      "description": "One of the largest things in the window: a tool's results or an MCP server's tool schemas.",
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "tokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "tokens"
      ],
      "type": "object"
    },
    "ContextWindowForecast": {
      "description": "Turns left before the window reaches its compaction point at the recent growth rate. Always an estimate.",
      "properties": {
        "growthPerTurn": {
          "format": "int64",
          "type": "integer"
        },
        "samples": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "turnsRemaining": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "growthPerTurn",
        "samples",
        "turnsRemaining"
      ],
      "type": "object"
    },
    "ContextWindowReading": {
      "properties": {
        "autoCompactTokens": {
          "description": "Where the harness auto-compacts, when it says.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "compactionOwner": {
          "$ref": "#/definitions/ContextCompactionOwner"
        },
        "consumers": {
          "items": {
            "$ref": "#/definitions/ContextWindowConsumer"
          },
          "type": "array"
        },
        "forecast": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContextWindowForecast"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string"
        },
        "percent": {
          "format": "int64",
          "type": "integer"
        },
        "segments": {
          "description": "Largest first; empty when the harness does not split its window.",
          "items": {
            "$ref": "#/definitions/ContextWindowSegment"
          },
          "type": "array"
        },
        "source": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/ContextReadingState"
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "usedTokens": {
          "format": "int64",
          "type": "integer"
        },
        "windowTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "compactionOwner",
        "consumers",
        "observedAt",
        "percent",
        "segments",
        "source",
        "state",
        "usedTokens",
        "windowTokens"
      ],
      "type": "object"
    },
    "ContextWindowRole": {
      "description": "Where a window sits in the agent tree of the requested chat.",
      "enum": [
        "chat",
        "orchestrator",
        "worker"
      ],
      "type": "string"
    },
    "ContextWindowSegment": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/ContextSegmentKind"
        },
        "name": {
          "type": "string"
        },
        "tokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "name",
        "tokens"
      ],
      "type": "object"
    },
    "EarlierContextWindow": {
      "description": "The last reading of a window this chat has since replaced (a model switch or a fresh provider thread).",
      "properties": {
        "harness": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": "string"
        },
        "percent": {
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "$ref": "#/definitions/ContextReadingState"
        },
        "usedTokens": {
          "format": "int64",
          "type": "integer"
        },
        "windowTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "harness",
        "observedAt",
        "percent",
        "state",
        "usedTokens",
        "windowTokens"
      ],
      "type": "object"
    }
  },
  "description": "`sessions/get_context_windows`'s result: every live window in the chat's agent tree, the chat's replaced windows, and Bridge's own share.",
  "properties": {
    "bridge": {
      "anyOf": [
        {
          "$ref": "#/definitions/ContextBridgeContribution"
        },
        {
          "type": "null"
        }
      ]
    },
    "earlier": {
      "items": {
        "$ref": "#/definitions/EarlierContextWindow"
      },
      "type": "array"
    },
    "sessionId": {
      "type": "string"
    },
    "windows": {
      "items": {
        "$ref": "#/definitions/ContextWindow"
      },
      "type": "array"
    }
  },
  "required": [
    "earlier",
    "sessionId",
    "windows"
  ],
  "title": "ContextWindowsResult",
  "type": "object"
}
