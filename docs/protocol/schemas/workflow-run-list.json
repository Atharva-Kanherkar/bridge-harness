{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HarnessId": {
      "description": "Which agent runs a session, e.g. 'claude', 'codex', 'gemini'. Identifies the agent only — how Bridge runs it is not encoded here.",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "WorkflowEventKind": {
      "description": "The events a workflow can start on.",
      "oneOf": [
        {
          "description": "Someone @-mentioned the account owner in Slack.",
          "enum": [
            "slack_mention"
          ],
          "type": "string"
        },
        {
          "description": "A Slack direct message to the account owner.",
          "enum": [
            "slack_direct_message"
          ],
          "type": "string"
        },
        {
          "description": "A reply in a Slack thread the account owner is part of.",
          "enum": [
            "slack_thread_reply"
          ],
          "type": "string"
        },
        {
          "description": "A pull request was opened in `repo`.",
          "enum": [
            "github_pull_request_opened"
          ],
          "type": "string"
        },
        {
          "description": "An issue was opened in `repo`.",
          "enum": [
            "github_issue_opened"
          ],
          "type": "string"
        },
        {
          "description": "The person's review was requested on a pull request (in `repo`, if set).",
          "enum": [
            "github_review_requested"
          ],
          "type": "string"
        },
        {
          "description": "A new email arrived in the Gmail inbox (`from` filters the sender).",
          "enum": [
            "gmail_message_received"
          ],
          "type": "string"
        },
        {
          "description": "A Linear issue was assigned to the person (`channel` filters the team).",
          "enum": [
            "linear_issue_assigned"
          ],
          "type": "string"
        },
        {
          "description": "A page was added to a Notion database (`channel` names the database and is required; `from` filters who created the page).",
          "enum": [
            "notion_page_created"
          ],
          "type": "string"
        }
      ]
    },
    "WorkflowEventSample": {
      "additionalProperties": false,
      "description": "One event, as a run, a preview or a dry run carries it. `payload` is the source's own record and is untrusted: other people wrote it.",
      "properties": {
        "key": {
          "description": "Stable across re-reads: how an event is recognised again.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/WorkflowEventKind"
        },
        "occurredAt": {
          "type": "string"
        },
        "payload": {
          "default": null
        },
        "title": {
          "description": "A short line for a person: `#eng · Alex: can you look at…`.",
          "type": "string"
        },
        "url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "kind",
        "occurredAt",
        "title"
      ],
      "type": "object"
    },
    "WorkflowRun": {
      "description": "One firing of a workflow.",
      "properties": {
        "costMicrousd": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "event": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkflowEventSample"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The event that started it (the first, for a batch)."
        },
        "eventCount": {
          "default": 0,
          "description": "How many events it carries: 1 for one event, more for a batch.",
          "format": "int64",
          "type": "integer"
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "missedSlots": {
          "format": "int64",
          "type": "integer"
        },
        "quotaUnknown": {
          "description": "The provider reported no usage, so the quota reserve could not be checked.",
          "type": "boolean"
        },
        "revisionId": {
          "type": "string"
        },
        "scheduledFor": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/WorkflowRunStatus"
        },
        "steps": {
          "default": [],
          "description": "The steps that started, in order. Steps not listed have not started.",
          "items": {
            "$ref": "#/definitions/WorkflowRunStep"
          },
          "type": "array"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "triggerKind": {
          "$ref": "#/definitions/WorkflowTriggerKind"
        },
        "unread": {
          "type": "boolean"
        },
        "workflowId": {
          "type": "string"
        }
      },
      "required": [
        "createdAt",
        "dryRun",
        "id",
        "missedSlots",
        "quotaUnknown",
        "revisionId",
        "status",
        "triggerKind",
        "unread",
        "workflowId"
      ],
      "type": "object"
    },
    "WorkflowRunStatus": {
      "description": "Where a run is. The first four are active: at most one per workflow.",
      "oneOf": [
        {
          "enum": [
            "queued",
            "waiting_quota",
            "running",
            "waiting_approval",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "The session ended without the result block the workflow asks for.",
          "enum": [
            "unverified"
          ],
          "type": "string"
        },
        {
          "description": "Recorded, never run: another run of this workflow was active.",
          "enum": [
            "skipped"
          ],
          "type": "string"
        }
      ]
    },
    "WorkflowRunStep": {
      "description": "One started step of a run.",
      "properties": {
        "costMicrousd": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "$ref": "#/definitions/HarnessId"
        },
        "index": {
          "description": "0 for the first step.",
          "format": "int64",
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkflowRunStatus"
            }
          ],
          "description": "`running` or `waiting_approval` while it works, then how it ended."
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "harness",
        "index",
        "model",
        "sessionId",
        "startedAt",
        "status"
      ],
      "type": "object"
    },
    "WorkflowTriggerKind": {
      "description": "Why a run started.",
      "oneOf": [
        {
          "enum": [
            "manual",
            "schedule"
          ],
          "type": "string"
        },
        {
          "description": "The latest of one or more slots missed while Bridge was not running.",
          "enum": [
            "catch_up"
          ],
          "type": "string"
        },
        {
          "description": "One event, or a batch of them.",
          "enum": [
            "event"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "runs": {
      "items": {
        "$ref": "#/definitions/WorkflowRun"
      },
      "type": "array"
    }
  },
  "required": [
    "runs"
  ],
  "title": "WorkflowRunList",
  "type": "object"
}
