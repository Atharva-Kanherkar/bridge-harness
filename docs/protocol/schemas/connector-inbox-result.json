{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ConnectorCardBlock": {
      "description": "One renderable block. A closed set: the harness picks from these, it never authors markup, so no connector message can become script or layout.\n\n**Adding a kind** is one variant here, one in `connector_surface::CardBlock`, one arm in the render prompt's block list, and one arm in the pane's renderer. Four edits, all of which the compiler or a test will demand — see `docs/connector-families.md`. The set stays closed on purpose: it is the reason a connector message can never become markup, and the reason this surface needs no iframe.\n\nClients render an unrecognised kind as plain text rather than dropping it, so a newer host talking to an older client degrades instead of going blank.",
      "oneOf": [
        {
          "properties": {
            "author": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "message"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "timestamp": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "author",
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "context"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "summary"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "fact"
              ],
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "label",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ConnectorCardPayload": {
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/definitions/ConnectorCardBlock"
          },
          "type": "array"
        },
        "harnessRendered": {
          "description": "False when Bridge authored this card after refusing the harness's.",
          "type": "boolean"
        },
        "headline": {
          "type": "string"
        },
        "itemKey": {
          "type": "string"
        },
        "suggestedReplies": {
          "description": "Drafts the user edits. Sending one still needs the same approval as any other reply.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "blocks",
        "harnessRendered",
        "headline",
        "itemKey",
        "suggestedReplies"
      ],
      "type": "object"
    },
    "ConnectorInboxItem": {
      "properties": {
        "author": {
          "type": "string"
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/definitions/ConnectorCardPayload"
            },
            {
              "type": "null"
            }
          ]
        },
        "channelId": {
          "type": "string"
        },
        "channelLabel": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "itemKey": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ConnectorItemKind"
        },
        "permalink": {
          "type": [
            "string",
            "null"
          ]
        },
        "receivedAt": {
          "type": "string"
        },
        "renderRejection": {
          "description": "Why the harness's card was refused, when it was.",
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/ConnectorItemState"
        },
        "text": {
          "description": "The message body. Untrusted third-party content — display it as text.",
          "type": "string"
        }
      },
      "required": [
        "author",
        "channelId",
        "channelLabel",
        "family",
        "itemKey",
        "kind",
        "receivedAt",
        "state",
        "text"
      ],
      "type": "object"
    },
    "ConnectorItemKind": {
      "enum": [
        "directMessage",
        "mention",
        "threadReply"
      ],
      "type": "string"
    },
    "ConnectorItemState": {
      "oneOf": [
        {
          "enum": [
            "rendered",
            "resolved"
          ],
          "type": "string"
        },
        {
          "description": "Announced, no card yet. The toast is already up.",
          "enum": [
            "pending"
          ],
          "type": "string"
        }
      ]
    },
    "ConnectorPollStatus": {
      "description": "What the last ingress cycle did, per family. Present so the pane can say \"could not read\" instead of showing an empty inbox that isn't.",
      "properties": {
        "degraded": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": "string"
        },
        "lastAttemptAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastSuccessAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "family"
      ],
      "type": "object"
    }
  },
  "properties": {
    "includeReadMentions": {
      "description": "Carried on the read the pane already makes, so the toggle can render its stored state without a second round-trip that could disagree with this one.",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/definitions/ConnectorInboxItem"
      },
      "type": "array"
    },
    "poll": {
      "items": {
        "$ref": "#/definitions/ConnectorPollStatus"
      },
      "type": "array"
    },
    "unreadCount": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "includeReadMentions",
    "items",
    "poll",
    "unreadCount"
  ],
  "title": "ConnectorInboxResult",
  "type": "object"
}
