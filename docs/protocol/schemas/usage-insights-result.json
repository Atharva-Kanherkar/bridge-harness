{
  "$comment": "GENERATED by bridge-protocol — do not edit. Regenerate: cargo run --manifest-path src-tauri/Cargo.toml -p bridge-protocol --bin generate-protocol-artifacts",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "UsageInsightDay": {
      "description": "Bridge-computed: one day's processed tokens, so the model's narrative can be checked against the shape it is describing.",
      "properties": {
        "day": {
          "type": "string"
        },
        "processedTokens": {
          "format": "int64",
          "type": "integer"
        },
        "prompts": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "day",
        "processedTokens",
        "prompts"
      ],
      "type": "object"
    },
    "UsageInsightGithub": {
      "description": "Bridge-computed from `gh`, for the workspaces Bridge knows. Absent when the GitHub CLI is missing or signed out.",
      "properties": {
        "awaitingReview": {
          "format": "int64",
          "type": "integer"
        },
        "draftPrs": {
          "format": "int64",
          "type": "integer"
        },
        "failingChecks": {
          "format": "int64",
          "type": "integer"
        },
        "openPrs": {
          "format": "int64",
          "type": "integer"
        },
        "repositories": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "awaitingReview",
        "draftPrs",
        "failingChecks",
        "openPrs",
        "repositories"
      ],
      "type": "object"
    },
    "UsageInsightHarness": {
      "description": "Bridge-computed, never model-authored: one harness's footprint in the window.",
      "properties": {
        "costMicrousd": {
          "format": "int64",
          "type": "integer"
        },
        "harness": {
          "type": "string"
        },
        "processedTokens": {
          "format": "int64",
          "type": "integer"
        },
        "prompts": {
          "format": "int64",
          "type": "integer"
        },
        "records": {
          "format": "int64",
          "type": "integer"
        },
        "sessions": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "costMicrousd",
        "harness",
        "processedTokens",
        "prompts",
        "records",
        "sessions"
      ],
      "type": "object"
    },
    "UsageInsightHighlight": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tone": {
          "$ref": "#/definitions/UsageInsightTone"
        }
      },
      "required": [
        "detail",
        "title",
        "tone"
      ],
      "type": "object"
    },
    "UsageInsightHour": {
      "description": "Bridge-computed: prompts sent per local hour of day, 24 entries.",
      "properties": {
        "hour": {
          "format": "int64",
          "type": "integer"
        },
        "prompts": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "hour",
        "prompts"
      ],
      "type": "object"
    },
    "UsageInsightTheme": {
      "description": "One theme the model found across the prompts it was shown. `share` is the model's estimate of the fraction of prompts it covers, 0–1.",
      "properties": {
        "example": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "share": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "label",
        "share"
      ],
      "type": "object"
    },
    "UsageInsightTone": {
      "description": "Emphasis on a highlight card, chosen by the model from a closed set.",
      "enum": [
        "neutral",
        "good",
        "watch"
      ],
      "type": "string"
    },
    "UsageInsightsReport": {
      "description": "The report the Insights tab renders. Numbers come from Bridge's own ledgers and are handed to the model as context; the prose comes from the model.",
      "properties": {
        "days": {
          "items": {
            "$ref": "#/definitions/UsageInsightDay"
          },
          "type": "array"
        },
        "github": {
          "anyOf": [
            {
              "$ref": "#/definitions/UsageInsightGithub"
            },
            {
              "type": "null"
            }
          ]
        },
        "harnesses": {
          "items": {
            "$ref": "#/definitions/UsageInsightHarness"
          },
          "type": "array"
        },
        "headline": {
          "type": "string"
        },
        "highlights": {
          "items": {
            "$ref": "#/definitions/UsageInsightHighlight"
          },
          "type": "array"
        },
        "hours": {
          "items": {
            "$ref": "#/definitions/UsageInsightHour"
          },
          "type": "array"
        },
        "promptsAnalysed": {
          "format": "int64",
          "type": "integer"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "themes": {
          "items": {
            "$ref": "#/definitions/UsageInsightTheme"
          },
          "type": "array"
        }
      },
      "required": [
        "days",
        "harnesses",
        "headline",
        "highlights",
        "hours",
        "promptsAnalysed",
        "recommendations",
        "summary",
        "themes"
      ],
      "type": "object"
    },
    "UsageInsightsStatus": {
      "description": "How a run ended. `unavailable` means no harness could be asked (nothing installed, or the one configured cannot run headless); `failed` names why the run that started did not produce a report.",
      "oneOf": [
        {
          "enum": [
            "ready",
            "unavailable",
            "failed"
          ],
          "type": "string"
        },
        {
          "description": "No report has ever been generated; nothing was attempted.",
          "enum": [
            "empty"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "detail": {
      "description": "Why there is no report, when there is none.",
      "type": [
        "string",
        "null"
      ]
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "harness": {
      "description": "The harness and model that wrote the prose.",
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/definitions/UsageInsightsReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/definitions/UsageInsightsStatus"
    },
    "windowDays": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "windowDays"
  ],
  "title": "UsageInsightsResult",
  "type": "object"
}
