{
  "manifest_version": 3,
  "name": "Bridge Authenticated Browser",
  "version": "0.5.2",
  "description": "Attach a user-approved Chrome tab to Bridge without copying browser credentials.",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "storage",
    "tabs",
    "tabCapture"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Attach this tab to Bridge" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
