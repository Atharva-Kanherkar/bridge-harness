      "now": "2026-11-26T03:00:00+00:00",
      "records": [
        { "body": "Writes commit messages in English, even on Japanese-speaking teams", "kind": "preference", "state": "proposed", "created": "2026-11-23", "confidence": 0.95 },
        { "body": "Prefers tabs over spaces in Go code", "kind": "preference", "state": "active", "created": "2026-10-01" }
      ],
      "expect": { "approve": [0], "keep": [1] }
    },
    {
      "name": "review-first-leaves-proposals",
      "mode": "propose",
      "now": "2026-11-26T03:00:00+00:00",
      "records": [
        { "body": "Is working on the rebase today", "kind": "fact", "state": "proposed", "created": "2026-11-25", "confidence": 0.7 },
        { "body": "Writes commit messages in English", "kind": "preference", "state": "proposed", "created": "2026-11-23", "confidence": 0.95 },
        { "body": "Prefers bun over npm", "kind": "preference", "state": "active", "created": "2026-10-01" },
        { "body": "Prefers bun over npm for scripts", "kind": "preference", "state": "proposed", "created": "2026-11-24", "confidence": 0.85 }
      ],
      "expect": { "junk": [0, 1], "reject": [3] }
    },
    {
      "name": "tidy-scope",
      "mode": "auto_apply",
      "now": "2026-11-26T03:00:00+00:00",
      "records": [
        { "body": "Prefers tabs over spaces in Go code", "kind": "preference", "state": "active", "created": "2026-10-01" },
        { "body": "Works in IST", "kind": "fact", "state": "active", "created": "2026-09-14" },
        { "body": "Uses bun for scripts", "kind": "preference", "state": "active", "created": "2026-10-20" },
        { "body": "Never push directly to main", "kind": "constraint", "state": "pin", "created": "2026-09-30" }
      ],
