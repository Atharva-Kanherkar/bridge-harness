{
  "schemaVersion": 1,
  "providers": [
    {
      "id": "claude",
      "messages": [
        { "type": "system", "subtype": "session_ready", "session_id": "claude-session" },
        { "type": "stream_event", "session_id": "claude-session", "event": { "type": "message_start", "message": { "id": "msg-1" } } },
        { "type": "stream_event", "session_id": "claude-session", "event": { "type": "content_block_delta", "delta": { "type": "text_delta", "text": "hello" } } },
        { "type": "stream_event", "session_id": "claude-session", "event": { "type": "content_block_start", "content_block": { "type": "tool_use", "id": "tool-1", "name": "Bash" } } },
        { "type": "control_request", "request_id": "permission-1", "request": { "subtype": "can_use_tool", "tool_use_id": "tool-1", "tool_name": "Bash", "tool_input": { "command": "pwd" } } },
        { "type": "user", "message": { "content": [{ "type": "tool_result", "tool_use_id": "tool-1", "content": "/tmp" }] } },
        { "type": "result", "subtype": "success", "result": "done", "usage": { "input_tokens": 10, "output_tokens": 2 } },
        { "type": "result", "subtype": "error_during_execution", "is_error": true, "result": "boom" }
      ],
      "expected": [
        { "kind": "session.started", "status": "ready" },
        { "kind": "message.delta", "itemId": "msg-1", "role": "assistant", "status": "streaming", "text": "hello" },
        { "kind": "tool.started", "itemId": "tool-1", "status": "inProgress", "title": "Bash" },
        { "kind": "approval.requested", "itemId": "tool-1", "status": "pending", "title": "Approve Bash", "text": "pwd" },
        { "kind": "tool.completed", "itemId": "tool-1", "status": "completed", "text": "/tmp" },
        { "kind": "turn.completed", "status": "completed" },
        { "kind": "usage.updated" },
        { "kind": "turn.completed", "status": "error_during_execution" },
        { "kind": "error", "status": "failed", "text": "boom" }
      ]
    },
    {
      "id": "codex",
      "messages": [
        { "method": "thread/started", "params": { "threadId": "thread-1" } },
        { "method": "turn/started", "params": { "turn": { "id": "turn-1" } } },
        { "method": "item/agentMessage/delta", "params": { "delta": "hello" } },
        { "method": "item/started", "params": { "item": { "id": "cmd-1", "type": "commandExecution", "status": "inProgress", "command": "cargo test" } } },
        { "id": 42, "method": "item/commandExecution/requestApproval", "params": { "itemId": "cmd-1", "reason": "run tests" } },
        { "method": "item/completed", "params": { "item": { "id": "cmd-1", "type": "commandExecution", "status": "completed", "command": "cargo test" } } },
        { "method": "error", "params": { "error": { "message": "boom" }, "willRetry": false } },
        { "method": "turn/completed", "params": { "turn": { "status": "completed" } } },
        { "method": "thread/tokenUsage/updated", "params": { "inputTokens": 10, "outputTokens": 2 } }
      ],
      "expected": [
        { "kind": "session.started" },
        { "kind": "turn.started", "status": "working" },
        { "kind": "message.delta", "role": "assistant", "text": "hello" },
        { "kind": "command.started", "itemId": "cmd-1", "status": "inProgress", "title": "cargo test" },
        { "kind": "approval.requested", "itemId": "cmd-1", "status": "pending", "title": "Approve command", "text": "run tests" },
        { "kind": "command.completed", "itemId": "cmd-1", "status": "completed", "title": "cargo test" },
        { "kind": "error", "status": "failed", "text": "boom" },
        { "kind": "turn.completed", "status": "completed" },
        { "kind": "usage.updated" }
      ]
    },
    {
      "id": "opencode",
      "messages": [
        { "type": "session.created", "properties": { "sessionID": "session-1" } },
        { "id": "turn-1", "type": "session.status", "properties": { "sessionID": "session-1", "status": { "type": "busy" } } },
        { "type": "message.updated", "properties": { "sessionID": "session-1", "info": { "id": "msg-1", "role": "assistant", "tokens": { "input": 10, "output": 2, "reasoning": 1, "cache": { "read": 3 } }, "modelID": "model", "providerID": "provider" } } },
        { "type": "message.part.delta", "properties": { "sessionID": "session-1", "messageID": "msg-1", "partID": "part-1", "field": "text", "delta": "hello" } },
        { "type": "message.part.updated", "properties": { "sessionID": "session-1", "part": { "id": "tool-1", "messageID": "msg-1", "type": "tool", "tool": "bash", "state": { "status": "running", "title": "Run tests", "output": "running" } } } },
        { "type": "permission.v2.asked", "properties": { "sessionID": "session-1", "id": "permission-1", "source": { "callID": "tool-1" }, "action": "bash", "resources": ["cargo test"] } },
        { "type": "session.error", "properties": { "sessionID": "session-1", "error": { "data": { "message": "boom" } } } },
        { "type": "session.idle", "properties": { "sessionID": "session-1" } }
      ],
      "expected": [
        { "kind": "session.started" },
        { "kind": "turn.started", "status": "working" },
        { "kind": "usage.updated", "itemId": "msg-1" },
        { "kind": "message.delta", "itemId": "part-1", "role": "assistant", "text": "hello" },
        { "kind": "command.started", "itemId": "tool-1", "status": "inProgress", "title": "Run tests", "text": "running" },
        { "kind": "approval.requested", "itemId": "tool-1", "status": "pending", "title": "Approve bash", "text": "cargo test" },
        { "kind": "error", "status": "failed", "text": "boom" },
        { "kind": "turn.completed", "status": "completed" }
      ]
    }
  ]
}
