#!/usr/bin/env node
// Fake OpenCode: `auth login` stores a key in XDG_DATA_HOME/opencode.
import fs from "node:fs"; import path from "node:path";
const args = process.argv.slice(2).join(" ");
if (args === "--version") { console.log("1.0.0"); process.exit(0); }
if (args === "auth login") {
  const dir = path.join(process.env.XDG_DATA_HOME || "", "opencode");
  console.log("Select provider\n● OpenCode Go");
  setTimeout(() => {
    fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(path.join(dir, "auth.json"), JSON.stringify({ "opencode-go": { type: "api", key: "sk-e2e" } }));
    console.log("Login successful");
    process.exit(0);
  }, 300);
} else process.exit(1);
