{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bridge desktop permissions",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "embedded-browser:allow-create",
    "embedded-browser:allow-close",
    "embedded-browser:allow-navigate",
    "embedded-browser:allow-action",
    "embedded-browser:allow-layout",
    "embedded-browser:allow-snapshot",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-set-webview-focus",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "notification:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
