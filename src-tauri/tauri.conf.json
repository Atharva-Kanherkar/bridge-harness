{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridge",
  "version": "0.1.0",
  "identifier": "dev.bridge.deck",
  "build": {
    "beforeDevCommand": "bun run prepare:browser-host:dev && bun run prepare:daemon:dev && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && bun run prepare:browser-host && bun run prepare:daemon",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [{
      "title": "Bridge",
      "width": 1380,
      "height": 860,
      "minWidth": 420,
      "minHeight": 480,
      "decorations": true,
      "transparent": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 18, "y": 15 },
      "acceptFirstMouse": true,
      "zoomHotkeysEnabled": true,
      "windowEffects": {
        "effects": ["sidebar"],
        "state": "followsWindowActiveState",
        "radius": 16
      }
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/bridge-browser-host", "binaries/bridged"],
    "resources": {
      "../browser-extension/": "browser-extension/",
      "../browser-skills/": "browser-skills/"
    },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
