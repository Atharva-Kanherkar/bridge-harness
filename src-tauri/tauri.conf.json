{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridge",
  "version": "0.5.1",
  "identifier": "dev.bridge.deck",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && bun run prepare:browser-host && bun run prepare:daemon && bun run prepare:claude-sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [{
      "title": "Bridge",
      "width": 1380,
      "height": 860,
      "minWidth": 420,
      "minHeight": 480,
      "decorations": true,
      "transparent": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 18, "y": 15 },
      "acceptFirstMouse": true,
      "zoomHotkeysEnabled": true,
      "windowEffects": {
        "effects": ["sidebar"],
        "state": "followsWindowActiveState",
        "radius": 16
      }
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/bridge-browser-host", "binaries/bridged"],
    "resources": {
      "../browser-extension/": "browser-extension/",
      "../browser-skills/": "browser-skills/",
      "resources/sidecar/claude-agent/": "sidecar/claude-agent/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
