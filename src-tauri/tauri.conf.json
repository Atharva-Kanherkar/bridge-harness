{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridge",
  "version": "0.1.0",
  "identifier": "dev.bridge.deck",
  "build": {
    "beforeDevCommand": "bun run prepare:browser-host:dev && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && bun run prepare:browser-host",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "title": "Bridge",
      "width": 1380,
      "height": 860,
      "minWidth": 760,
      "minHeight": 560,
      "decorations": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 18, "y": 15 },
      "acceptFirstMouse": true,
      "windowEffects": {
        "effects": ["hudWindow"],
        "state": "active"
      }
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/bridge-browser-host"],
    "resources": {
      "../browser-extension/": "browser-extension/",
      "../browser-skills/": "browser-skills/"
    },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
