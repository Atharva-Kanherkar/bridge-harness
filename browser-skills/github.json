{
  "id": "github-review-and-submit",
  "name": "GitHub review and submit",
  "domains": ["github.com"],
  "description": "Review a GitHub form semantically and require approval before creating, merging, or commenting.",
  "steps": [
    { "action": "snapshot", "select": ["textbox", "button", "link"] },
    { "action": "fill", "match": { "role": "textbox" }, "fromInput": true },
    { "action": "approval", "before": ["submit", "send", "merge", "delete"] },
    { "action": "verify", "evidence": ["url", "statusText", "screenshot"] }
  ]
}
