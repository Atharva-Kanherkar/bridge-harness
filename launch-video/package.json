    "@remotion/tailwind-v4": "4.0.523",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.523"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "6.4.3"
